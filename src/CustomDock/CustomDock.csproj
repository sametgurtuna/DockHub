<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK projeksiyonları: SMTC (Windows.Media.Control), Geolocation, Toast bildirimleri -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Sadece NotifyIcon (tray) için -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CustomDock</RootNamespace>
    <AssemblyName>DockHub</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DockHub.ico</ApplicationIcon>
    <Version>0.4.0</Version>
    <Product>DockHub</Product>
    <Company>DockHub</Company>
    <Copyright>© 2026</Copyright>
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
    <!-- DPI farkındalığı WPF için app.manifest üzerinden (PerMonitorV2) ayarlanır. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF ve WinForms tiplerinin (Application, Button, MessageBox...) çakışmasını önler -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\DockHub.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- Kabuk (shell) servisleri: görev listesi, sistem tepsisi, AppBar, Explorer görev çubuğunu gizleme. Apache-2.0 -->
    <PackageReference Include="ManagedShell" Version="0.0.372" />
  </ItemGroup>

</Project>
