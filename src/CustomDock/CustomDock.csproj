<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK projections: SMTC (Windows.Media.Control), Geolocation, Toast notifications -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only for NotifyIcon (tray) -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CustomDock</RootNamespace>
    <AssemblyName>DockHub</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DockHub.ico</ApplicationIcon>
    <Version>0.7.0</Version>
    <Product>DockHub</Product>
    <Company>DockHub</Company>
    <Copyright>© 2026</Copyright>
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
    <!-- DPI awareness for WPF is configured via app.manifest (PerMonitorV2). -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Prevents collision between WPF and WinForms types (Application, Button, MessageBox...) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\DockHub.ico" />
    <InternalsVisibleTo Include="CustomDock.Tests" />
    <EmbeddedResource Include="Resources\Strings_*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- Shell services: task list, system tray, AppBar, Explorer taskbar hiding. Apache-2.0 -->
    <PackageReference Include="ManagedShell" Version="0.0.372" />
  </ItemGroup>

</Project>
