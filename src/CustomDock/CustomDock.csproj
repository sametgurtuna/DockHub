<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK projections: SMTC (Windows.Media.Control), Geolocation, Toast notifications -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only for NotifyIcon (tray) -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CustomDock</RootNamespace>
    <AssemblyName>DockHub</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DockHub.ico</ApplicationIcon>
    <Version>0.9.1</Version>
    <Product>DockHub</Product>
    <Company>DockHub</Company>
    <Copyright>© 2026</Copyright>
    <SatelliteResourceLanguages>en;tr;de;es</SatelliteResourceLanguages>
    <!-- DPI awareness for WPF is configured via app.manifest (PerMonitorV2). -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!--
      A dock is small and idle most of the time. Without background GC there is no extra GC thread and the heap is
      compacted in place (its pauses are sub-millisecond at this heap size); profile-guided tiering only pays off for
      hot server loops and costs memory for its instrumentation.
    -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compact the heap more eagerly so freed memory goes back to Windows instead of staying reserved. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Prevents collision between WPF and WinForms types (Application, Button, MessageBox...) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\DockHub.ico" />
    <InternalsVisibleTo Include="CustomDock.Tests" />
    <EmbeddedResource Include="Resources\Strings_*.json" />
    <EmbeddedResource Include="Resources\battery-devices.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ical.Net" Version="4.2.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- Shell services: task list, system tray, AppBar, Explorer taskbar hiding. Apache-2.0 -->
    <PackageReference Include="ManagedShell" Version="0.0.372" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <!-- Laptop screen brightness (WMI) -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
