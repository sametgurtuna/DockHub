<Window x:Class="CustomDock.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:CustomDock.Controls"
        xmlns:core="clr-namespace:CustomDock.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DockHub"
        Width="1120" Height="760" MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/DockHub;component/Assets/DockHub.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="-1"
                            UseAeroCaptionButtons="True" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WidgetSettingsTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ctl:EnumEqualsConverter x:Key="EnumEq" />
            <ctl:InverseBoolConverter x:Key="Not" />
            <ctl:PercentConverter x:Key="Percent" />

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="2,0,0,4" />
            </Style>
            <Style x:Key="PageSubtitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="2,0,0,10" />
            </Style>
            <Style x:Key="Page" TargetType="FrameworkElement">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="MaxWidth" Value="980" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="NavGlyph" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Width" Value="20" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar ===================== -->
        <Border Background="{DynamicResource SidebarBrush}">
            <DockPanel Margin="12,12,12,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,22" Height="30">
                    <Image Source="pack://application:,,,/DockHub;component/Assets/DockHub.ico" Width="20" Height="20"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <TextBlock Text="DockHub" Margin="10,0,0,0" FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="8,0,0,0">
                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11.5" />
                </StackPanel>

                <ListBox x:Name="NavList" Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="OnNavigationChanged">
                    <ListBoxItem Tag="general">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource NavGlyph}" />
                            <TextBlock Text="General" Margin="14,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="taskbar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE75B;" Style="{StaticResource NavGlyph}" />
                            <TextBlock Text="Taskbar" Margin="14,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="appearance">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;" Style="{StaticResource NavGlyph}" />
                            <TextBlock Text="Appearance" Margin="14,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="items">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" Style="{StaticResource NavGlyph}" />
                            <TextBlock Text="Dock items" Margin="14,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="gallery">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xECA5;" Style="{StaticResource NavGlyph}" />
                            <TextBlock Text="Widget gallery" Margin="14,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="about">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" Style="{StaticResource NavGlyph}" />
                            <TextBlock Text="About" Margin="14,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===================== Pages ===================== -->
        <ScrollViewer x:Name="PageScroller" Grid.Column="1" Margin="0,44,0,0" Padding="32,4,36,28" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- ============ General ============ -->
                <StackPanel x:Name="GeneralPage" Style="{StaticResource Page}">
                    <TextBlock Text="General" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Startup, Windows taskbar, and maintenance." Style="{StaticResource PageSubtitle}" />

                    <TextBlock Text="Windows taskbar" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE75B;" Header="Replace taskbar"
                                    Description="DockHub replaces the Windows taskbar with Start, search, running apps, and system tray. If disabled, both will appear together.">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Taskbar" Content="DockHub"
                                             IsChecked="{Binding TaskbarMode, Converter={StaticResource EnumEq}, ConverterParameter=Replace}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Taskbar" Content="Show both"
                                             IsChecked="{Binding TaskbarMode, Converter={StaticResource EnumEq}, ConverterParameter=ShowBoth}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>
                    <Border CornerRadius="6" Padding="14,10" Margin="0,0,0,3" Background="{DynamicResource WarningBackgroundBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" Foreground="{DynamicResource AccentOrangeBrush}" VerticalAlignment="Top" Margin="0,2,10,0" />
                            <TextBlock TextWrapping="Wrap" MaxWidth="720"
                                       Text="DockHub will restart when this setting is changed. When the app is closed (or on the next launch if terminated unexpectedly), the Windows taskbar is automatically restored." />
                        </StackPanel>
                    </Border>
                    <ctl:SettingRow Glyph="&#xE740;" Header="Hide in full screen apps"
                                    Description="Hides dock in games, videos, or F11 full screen mode.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HideOnFullscreen}" />
                    </ctl:SettingRow>

                    <TextBlock Text="Startup" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE7E8;" Header="Start with Windows"
                                    Description="Automatically launch DockHub when you sign in.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE718;" Header="Explorer &quot;Pin to DockHub&quot;"
                                    Description="Adds a dock pin command when right-clicking an app or shortcut. Found under &quot;Show more options&quot; (or Shift + right click) on Windows 11.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ExplorerPinMenu}" />
                    </ctl:SettingRow>

                    <TextBlock Text="Maintenance" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE777;" Header="Restore Windows taskbar"
                                    Description="If the taskbar remains hidden due to an issue. (Command line: DockHub.exe --restore-taskbar)">
                        <Button Content="Restore" Click="OnRestoreTaskbarClick" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE72C;" Header="Restart DockHub">
                        <Button Content="Restart" Click="OnRestartClick" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE8B7;" Header="Settings and data folder" x:Name="ConfigFolderRow">
                        <Button Content="Open folder" Click="OnOpenConfigFolderClick" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE7E8;" Header="Exit DockHub" Description="Restores the Windows taskbar.">
                        <Button Content="Exit" Click="OnExitClick" />
                    </ctl:SettingRow>
                </StackPanel>

                <!-- ============ Taskbar ============ -->
                <StackPanel x:Name="TaskbarPage" Style="{StaticResource Page}">
                    <TextBlock Text="Taskbar" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="System items located at the start and end of the dock." Style="{StaticResource PageSubtitle}" />

                    <TextBlock Text="Left side" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE8A9;" Header="Start button" Description="Right-click: Windows quick link / power user menu (Win+X).">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowStartButton}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE721;" Header="Search">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowSearchButton}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE7C4;" Header="Task view">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowTaskViewButton}" />
                    </ctl:SettingRow>

                    <TextBlock Text="Applications" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE8A9;" Header="Show unpinned running apps"
                                    Description="Running applications that are not pinned to the dock appear after a separator. Right-click to pin or drag and drop anywhere.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowRunningApps}" />
                    </ctl:SettingRow>

                    <TextBlock Text="Right side" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE7EB;" Header="System tray" x:Name="TrayRow"
                                    Description="Icons of applications running in the background. Only available in 'DockHub' mode.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowTray}" />
                    </ctl:SettingRow>
                    <Border x:Name="TrayIconsCard" Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <TextBlock Text="Always visible icons" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Hidden icons are grouped under the ˄ button." Style="{StaticResource SettingDescription}" />
                            <ItemsControl x:Name="TrayIconList" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,12,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsPinned, Mode=OneWay}"
                                                      Click="OnTrayPinClick" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <ctl:SettingRow Glyph="&#xE823;" Header="Clock" Description="Click to open calendar and notifications.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowClock}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE787;" Header="Show date">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ClockShowDate}" IsEnabled="{Binding ShowClock}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE916;" Header="Show seconds">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ClockShowSeconds}" IsEnabled="{Binding ShowClock}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE7F4;" Header="Show desktop button" Description="The slim strip at the far right of the dock.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowDesktopButton}" />
                    </ctl:SettingRow>
                </StackPanel>

                <!-- ============ Appearance ============ -->
                <StackPanel x:Name="AppearancePage" Style="{StaticResource Page}">
                    <TextBlock Text="Appearance" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Theme, glass effect, size, and layout." Style="{StaticResource PageSubtitle}" />

                    <TextBlock Text="Style" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE790;" Header="Theme">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Theme" Content="Dark"
                                             IsChecked="{Binding Theme, Converter={StaticResource EnumEq}, ConverterParameter=Dark}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Theme" Content="Light"
                                             IsChecked="{Binding Theme, Converter={StaticResource EnumEq}, ConverterParameter=Light}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Theme" Content="System"
                                             IsChecked="{Binding Theme, Converter={StaticResource EnumEq}, ConverterParameter=System}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xF570;" Header="Backdrop"
                                    Description="Blur: blurs content behind the dock. Acrylic: adds Windows translucent texture. Solid: no blur.">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Backdrop" Content="Blur"
                                             IsChecked="{Binding Backdrop, Converter={StaticResource EnumEq}, ConverterParameter=Blur}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Backdrop" Content="Acrylic"
                                             IsChecked="{Binding Backdrop, Converter={StaticResource EnumEq}, ConverterParameter=Acrylic}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Backdrop" Content="Solid"
                                             IsChecked="{Binding Backdrop, Converter={StaticResource EnumEq}, ConverterParameter=Solid}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE706;" Header="Tint opacity" Description="Color layer overlay on glass.">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="200" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                    IsSnapToTickEnabled="True" TickFrequency="0.05" Value="{Binding TintOpacity}" />
                            <TextBlock Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding TintOpacity, Converter={StaticResource Percent}}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE7B3;" Header="Card hover" Description="Widget card gently lights up when hovered.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HoverEffect}" />
                    </ctl:SettingRow>

                    <TextBlock Text="Size and shape" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE740;" Header="Size"
                                    Description="Size of the main dock. Docks on other displays can have their own size under Position.">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Size" Content="Small"
                                             IsChecked="{Binding Size, Converter={StaticResource EnumEq}, ConverterParameter=Small}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Size" Content="Medium"
                                             IsChecked="{Binding Size, Converter={StaticResource EnumEq}, ConverterParameter=Medium}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Size" Content="Large"
                                             IsChecked="{Binding Size, Converter={StaticResource EnumEq}, ConverterParameter=Large}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE8A9;" Header="Shape" Description="Floating: detached with rounded corners and margins. Attached: classic docked taskbar.">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Layout" Content="Floating"
                                             IsChecked="{Binding Layout, Converter={StaticResource EnumEq}, ConverterParameter=Floating}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Layout" Content="Attached"
                                             IsChecked="{Binding Layout, Converter={StaticResource EnumEq}, ConverterParameter=Attached}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE8C4;" Header="Edge margin">
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="MarginSlider" Width="200" Minimum="0" Maximum="24" SmallChange="1" LargeChange="2"
                                    IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding EdgeMargin}" />
                            <TextBlock Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding EdgeMargin, StringFormat={}{0:0} px}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE9A6;" Header="Width">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Width" Content="Full width"
                                             IsChecked="{Binding WidthMode, Converter={StaticResource EnumEq}, ConverterParameter=Full}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Width" Content="Fit content"
                                             IsChecked="{Binding WidthMode, Converter={StaticResource EnumEq}, ConverterParameter=Fit}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE8E3;" Header="Item alignment">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Align" Content="Start"
                                             IsChecked="{Binding Alignment, Converter={StaticResource EnumEq}, ConverterParameter=Start}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Align" Content="Center"
                                             IsChecked="{Binding Alignment, Converter={StaticResource EnumEq}, ConverterParameter=Center}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>

                    <TextBlock Text="Position" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE8A0;" Header="Screen edge">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Edge" Content="Bottom"
                                             IsChecked="{Binding Edge, Converter={StaticResource EnumEq}, ConverterParameter=Bottom}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Edge" Content="Top"
                                             IsChecked="{Binding Edge, Converter={StaticResource EnumEq}, ConverterParameter=Top}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Edge" Content="Left"
                                             IsChecked="{Binding Edge, Converter={StaticResource EnumEq}, ConverterParameter=Left}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Edge" Content="Right"
                                             IsChecked="{Binding Edge, Converter={StaticResource EnumEq}, ConverterParameter=Right}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE7F4;" Header="Main display"
                                    Description="Display for the main dock. Widgets and tray icons are shown here.">
                        <ComboBox x:Name="MonitorCombo" Width="260" DisplayMemberPath="Label" SelectionChanged="OnMonitorChanged" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE7F9;" Header="Show on all displays"
                                    Description="Adds a dock with your pinned apps, groups, Start and clock to every other connected display.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowOnAllDisplays}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE737;" Header="Running apps on their own display"
                                    Description="Each dock lists only the open apps whose windows are on its display."
                                    IsEnabled="{Binding ShowOnAllDisplays}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RunningAppsOnOwnDisplay}" />
                    </ctl:SettingRow>
                    <!-- One size row per other display (built in code, see LoadDisplaySizes) -->
                    <StackPanel x:Name="DisplaySizesPanel" />
                    <ctl:SettingRow Glyph="&#xE89F;" Header="Auto-hide"
                                    Description="The dock stays hidden until the mouse touches the screen edge. When disabled, windows do not overlap under the dock.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoHide}" />
                    </ctl:SettingRow>
                </StackPanel>

                <!-- ============ Dock items ============ -->
                <Grid x:Name="ItemsPage" Style="{StaticResource Page}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.ColumnSpan="3" Text="Dock items" Style="{StaticResource PageTitle}" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource PageSubtitle}"
                               Text="Apps, widgets, and separators are displayed in this order from left to right. Drag by the handle (or directly on the dock) to reorder." />

                    <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,0,0,12">
                        <Button Style="{StaticResource AccentButton}" Margin="0,0,8,0" Click="OnAddAppClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="12" />
                                <TextBlock Text="Add app" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,8,0" Click="OnOpenGalleryClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xECA5;" Style="{StaticResource IconText}" FontSize="12" />
                                <TextBlock Text="Add widget" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,8,0" Click="OnAddSeparatorClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE76F;" Style="{StaticResource IconText}" FontSize="12" />
                                <TextBlock Text="Add separator" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnImportPinsClick" ToolTip="Adds applications pinned to the Windows taskbar">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource IconText}" FontSize="12" />
                                <TextBlock Text="Import taskbar pins" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="6" VerticalAlignment="Top">
                        <ListBox x:Name="ItemList" Style="{StaticResource PlainListBox}" AllowDrop="True" MinHeight="120"
                                 SelectionChanged="OnItemSelectionChanged"
                                 PreviewMouseLeftButtonDown="OnItemListMouseDown"
                                 PreviewMouseMove="OnItemListMouseMove"
                                 DragOver="OnItemListDragOver"
                                 Drop="OnItemListDrop">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
                                    <Setter Property="Padding" Value="6,5" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE700;" Style="{StaticResource IconText}" FontSize="12" Width="18"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" Cursor="SizeAll" Tag="drag-handle" />
                                        <Border Grid.Column="1" Width="30" Height="30" CornerRadius="7" Margin="4,0,10,0"
                                                Background="{DynamicResource SubtleFillBrush}">
                                            <Grid>
                                                <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <Path Data="{Binding Glyph}" Stretch="Uniform" Width="15" Height="15" StrokeThickness="1.7"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Stroke="{Binding GlyphBrush}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,0,0,0">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE70E;" Width="24" Height="24" FontSize="10"
                                                    ToolTip="Move up" Click="OnMoveUpClick" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE70D;" Width="24" Height="24" FontSize="10"
                                                    ToolTip="Move down" Click="OnMoveDownClick" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" Width="24" Height="24" FontSize="10"
                                                    ToolTip="Remove" Click="OnRemoveItemClick" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <StackPanel Grid.Row="3" Grid.Column="2">
                        <TextBlock x:Name="EmptyDetail" Text="Select an item to view details." Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,8,0,0" />
                        <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,10">
                                <Border DockPanel.Dock="Left" Width="46" Height="46" CornerRadius="12" Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Image x:Name="DetailImage" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <Path x:Name="DetailGlyph" Stretch="Uniform" Width="22" Height="22" StrokeThickness="1.8"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Grid>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailTitle" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DetailSubtitle" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Preview -->
                            <Border x:Name="DetailPreviewHost" CornerRadius="16" Padding="8" HorizontalAlignment="Left" Margin="0,0,0,10"
                                    Background="{DynamicResource GalleryBackdropBrush}" Visibility="Collapsed" IsHitTestVisible="False" />

                            <!-- App -->
                            <StackPanel x:Name="AppDetail" Visibility="Collapsed">
                                <ctl:SettingRow Header="Display name" Description="Uses the application name if left empty.">
                                    <TextBox x:Name="AppNameBox" Width="220" LostFocus="OnAppNameChanged" KeyDown="OnAppNameKeyDown" />
                                </ctl:SettingRow>
                                <ctl:SettingRow x:Name="AppPathRow" Header="Target">
                                    <Button Content="Open location" Click="OnOpenAppLocationClick" />
                                </ctl:SettingRow>
                                <ctl:SettingRow Header="Launch arguments">
                                    <TextBox x:Name="AppArgsBox" Width="220" LostFocus="OnAppArgsChanged" />
                                </ctl:SettingRow>
                            </StackPanel>

                            <!-- Widget -->
                            <StackPanel x:Name="WidgetDetail" Visibility="Collapsed">
                                <ctl:SettingRow Header="Variant" Description="Appearance style of the widget on the dock.">
                                    <ComboBox x:Name="VariantCombo" Width="200" DisplayMemberPath="Name" SelectionChanged="OnVariantChanged" />
                                </ctl:SettingRow>
                                <ContentControl x:Name="WidgetSettingsHost" Focusable="False" />
                            </StackPanel>

                            <!-- Group / Folder -->
                            <StackPanel x:Name="GroupDetail" Visibility="Collapsed">
                                <ctl:SettingRow Header="Folder name" Description="The name displayed on the dock and in tooltips.">
                                    <TextBox x:Name="GroupNameBox" Width="220" LostFocus="OnGroupNameChanged" KeyDown="OnGroupNameKeyDown" />
                                </ctl:SettingRow>
                                <ctl:SettingRow Header="Folder color" Description="Accent color applied to the folder.">
                                    <ComboBox x:Name="GroupAccentCombo" Width="200" SelectionChanged="OnGroupAccentChanged" />
                                </ctl:SettingRow>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ============ Widget gallery ============ -->
                <StackPanel x:Name="GalleryPage" Style="{StaticResource Page}">
                    <TextBlock Text="Widget gallery" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Click the + button next to a widget to add it to the dock. Right-click added widgets on the dock to change their variant or open their settings."
                               Style="{StaticResource PageSubtitle}" />
                    <StackPanel x:Name="GalleryPanel" />
                </StackPanel>

                <!-- ============ About ============ -->
                <StackPanel x:Name="AboutPage" Style="{StaticResource Page}">
                    <TextBlock Text="About" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource SettingCard}" Padding="20" Margin="0,12,0,4">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/DockHub;component/Assets/DockHub.ico" Width="56" Height="56"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="DockHub" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock x:Name="AboutVersion" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="A widget-powered dock that replaces the Windows taskbar." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Open source software &amp; data used" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE7F4;" Header="ManagedShell" Description="Task list, system tray, and AppBar services (Apache-2.0).">
                        <Button Content="GitHub" Tag="https://github.com/cairoshell/ManagedShell" Click="OnOpenLinkClick" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE782;" Header="RetroBar" Description="Start menu and tray interaction patterns (Apache-2.0).">
                        <Button Content="GitHub" Tag="https://github.com/dremin/RetroBar" Click="OnOpenLinkClick" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE753;" Header="Open-Meteo" Description="Weather and geocoding data (CC BY 4.0).">
                        <Button Content="Open website" Tag="https://open-meteo.com/" Click="OnOpenLinkClick" />
                    </ctl:SettingRow>
                    <TextBlock Text="Tips" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE962;" Header="Right-click the dock" Description="Add widgets, pin apps, change position, and toggle auto-hide." />
                    <ctl:SettingRow Glyph="&#xE7C9;" Header="Mouse wheel" Description="Scroll horizontally when the dock overflows." />
                    <ctl:SettingRow Glyph="&#xE8A7;" Header="Middle click / Shift+click" Description="Opens a new window of the application." />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
