<Window x:Class="CustomDock.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:CustomDock.Controls"
        xmlns:core="clr-namespace:CustomDock.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DockHub"
        Width="1120" Height="760" MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/DockHub;component/Assets/DockHub.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="-1"
                            UseAeroCaptionButtons="True" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WidgetSettingsTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ctl:EnumEqualsConverter x:Key="EnumEq" />
            <ctl:InverseBoolConverter x:Key="Not" />
            <ctl:PercentConverter x:Key="Percent" />

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="2,0,0,4" />
            </Style>
            <Style x:Key="PageSubtitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="2,0,0,10" />
            </Style>
            <!-- Heading of a group in the menu (not selectable) -->
            <Style x:Key="NavGroupHeader" TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <TextBlock Text="{TemplateBinding Content}" Margin="10,14,0,4" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Category filter of the widget gallery -->
            <Style x:Key="GalleryChip" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="Margin" Value="0,0,6,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="{DynamicResource SubtleFillBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Page" TargetType="FrameworkElement">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="MaxWidth" Value="980" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="NavGlyph" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Width" Value="20" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar ===================== -->
        <Border Background="{DynamicResource SidebarBrush}">
            <DockPanel Margin="12,12,12,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,22" Height="30">
                    <Image Source="pack://application:,,,/DockHub;component/Assets/DockHub.ico" Width="20" Height="20"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <TextBlock Text="DockHub" Margin="10,0,0,0" FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="8,0,0,0">
                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11.5" />
                </StackPanel>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBox x:Name="SettingsSearchBox" MinHeight="32" VerticalContentAlignment="Center" Padding="30,0,8,0"
                             TextChanged="OnSettingsSearchChanged" PreviewKeyDown="OnSettingsSearchKeyDown"
                             ToolTip="Search settings and widgets (Ctrl+F)" />
                    <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="12" Margin="11,0,0,0" IsHitTestVisible="False"
                               VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock x:Name="SettingsSearchHint" Text="Find a setting" Margin="30,0,0,0" IsHitTestVisible="False"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                </Grid>

                <ListBox x:Name="SearchResults" DockPanel.Dock="Top" Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource NavItem}"
                         Visibility="Collapsed" SelectionChanged="OnSearchResultSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,1">
                                <TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Location}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox x:Name="NavList" Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="OnNavigationChanged">
                    <!-- Built from SettingsPages (grouped: Dock, Widgets, System, About) -->
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===================== Pages ===================== -->
        <ScrollViewer x:Name="PageScroller" Grid.Column="1" Margin="0,44,0,0" Padding="32,4,36,28" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- ============ Overview ============ -->
                <StackPanel x:Name="OverviewPage" Style="{StaticResource Page}">
                    <TextBlock Text="Overview" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Your dock at a glance, the settings you change most, and a few shortcuts." Style="{StaticResource PageSubtitle}" />

                    <ctl:MiniDockPreview x:Name="OverviewPreview" Margin="0,4,0,6" />

                    <TextBlock Text="Shortcuts" Style="{StaticResource SectionHeader}" />
                    <WrapPanel x:Name="OverviewActions" Margin="0,0,0,4" />

                    <TextBlock Text="Quick settings" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE790;" Header="Theme">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="OverviewTheme" Content="Dark"
                                             IsChecked="{Binding Theme, Converter={StaticResource EnumEq}, ConverterParameter=Dark}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="OverviewTheme" Content="Light"
                                             IsChecked="{Binding Theme, Converter={StaticResource EnumEq}, ConverterParameter=Light}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="OverviewTheme" Content="System"
                                             IsChecked="{Binding Theme, Converter={StaticResource EnumEq}, ConverterParameter=System}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xF570;" Header="Backdrop">
                        <Border Style="{StaticResource SegmentedHost}">
                            <WrapPanel>
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="OverviewBackdrop" Content="Blur"
                                             IsChecked="{Binding Backdrop, Converter={StaticResource EnumEq}, ConverterParameter=Blur}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="OverviewBackdrop" Content="Acrylic"
                                             IsChecked="{Binding Backdrop, Converter={StaticResource EnumEq}, ConverterParameter=Acrylic}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="OverviewBackdrop" Content="Transparent"
                                             IsChecked="{Binding Backdrop, Converter={StaticResource EnumEq}, ConverterParameter=Transparent}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="OverviewBackdrop" Content="Solid"
                                             IsChecked="{Binding Backdrop, Converter={StaticResource EnumEq}, ConverterParameter=Solid}" />
                            </WrapPanel>
                        </Border>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE740;" Header="Size">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="OverviewSize" Content="Small"
                                             IsChecked="{Binding Size, Converter={StaticResource EnumEq}, ConverterParameter=Small}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="OverviewSize" Content="Medium"
                                             IsChecked="{Binding Size, Converter={StaticResource EnumEq}, ConverterParameter=Medium}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="OverviewSize" Content="Large"
                                             IsChecked="{Binding Size, Converter={StaticResource EnumEq}, ConverterParameter=Large}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE8A0;" Header="Screen edge">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="OverviewEdge" Content="Bottom"
                                             IsChecked="{Binding Edge, Converter={StaticResource EnumEq}, ConverterParameter=Bottom}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="OverviewEdge" Content="Top"
                                             IsChecked="{Binding Edge, Converter={StaticResource EnumEq}, ConverterParameter=Top}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="OverviewEdge" Content="Left"
                                             IsChecked="{Binding Edge, Converter={StaticResource EnumEq}, ConverterParameter=Left}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="OverviewEdge" Content="Right"
                                             IsChecked="{Binding Edge, Converter={StaticResource EnumEq}, ConverterParameter=Right}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE8A1;" Header="Top bar">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding TopBar.Enabled}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE80A;" Header="Widget style">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="OverviewWidgetStyle" Content="Cards"
                                             IsChecked="{Binding WidgetStyle, Converter={StaticResource EnumEq}, ConverterParameter=Cards}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="OverviewWidgetStyle" Content="Seamless"
                                             IsChecked="{Binding WidgetStyle, Converter={StaticResource EnumEq}, ConverterParameter=Seamless}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>

                    <TextBlock Text="Status" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow x:Name="OverviewVersionRow" Glyph="&#xE895;" Header="Version">
                        <Button x:Name="OverviewUpdateButton" Content="Updates" Click="OnOverviewUpdatesClick" />
                    </ctl:SettingRow>
                    <ctl:SettingRow x:Name="OverviewBackupRow" Glyph="&#xE90F;" Header="Automatic backup">
                        <Button Content="Backup and troubleshooting" Click="OnOverviewBackupClick" />
                    </ctl:SettingRow>
                    <ctl:SettingRow x:Name="OverviewProfileRow" Glyph="&#xE77B;" Header="Profile">
                        <Button Content="Profiles" Click="OnOverviewProfilesClick" />
                    </ctl:SettingRow>
                </StackPanel>

                <!-- ============ General ============ -->
                <StackPanel x:Name="GeneralPage" Style="{StaticResource Page}">
                    <TextBlock Text="General" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Windows taskbar, startup and language." Style="{StaticResource PageSubtitle}" />

                    <TextBlock Text="Windows taskbar" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE75B;" Header="Replace taskbar"
                                    Description="DockHub replaces the Windows taskbar with Start, search, running apps, and system tray. If disabled, both will appear together.">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Taskbar" Content="DockHub"
                                             IsChecked="{Binding TaskbarMode, Converter={StaticResource EnumEq}, ConverterParameter=Replace}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Taskbar" Content="Show both"
                                             IsChecked="{Binding TaskbarMode, Converter={StaticResource EnumEq}, ConverterParameter=ShowBoth}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>
                    <Border CornerRadius="6" Padding="14,10" Margin="0,0,0,3" Background="{DynamicResource WarningBackgroundBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" Foreground="{DynamicResource AccentOrangeBrush}" VerticalAlignment="Top" Margin="0,2,10,0" />
                            <TextBlock TextWrapping="Wrap" MaxWidth="720"
                                       Text="DockHub will restart when this setting is changed. When the app is closed (or on the next launch if terminated unexpectedly), the Windows taskbar is automatically restored." />
                        </StackPanel>
                    </Border>
                    <ctl:SettingRow Glyph="&#xE740;" Header="Hide in full screen apps"
                                    Description="Hides dock in games, videos, or F11 full screen mode.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HideOnFullscreen}" />
                    </ctl:SettingRow>

                    <TextBlock Text="Startup" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE7E8;" Header="Start with Windows"
                                    Description="Automatically launch DockHub when you sign in.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE718;" Header="Explorer &quot;Pin to DockHub&quot;"
                                    Description="Adds a dock pin command when right-clicking an app or shortcut. Found under &quot;Show more options&quot; (or Shift + right click) on Windows 11.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ExplorerPinMenu}" />
                    </ctl:SettingRow>

                    <TextBlock Text="Language" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xF2B7;" Header="Interface language" Description="System follows your Windows display language. DockHub restarts to switch.">
                        <ComboBox x:Name="LanguageCombo" Width="160" SelectionChanged="OnLanguageChanged" />
                    </ctl:SettingRow>

                </StackPanel>

                <!-- ============ Profiles ============ -->
                <StackPanel x:Name="ProfilesPage" Style="{StaticResource Page}">
                    <TextBlock Text="Profiles" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Separate dock setups that switch by hand or by themselves." Style="{StaticResource PageSubtitle}" />
                    <StackPanel x:Name="ProfileRows" />
                    <ctl:SettingRow Glyph="&#xE77B;" Header="Save current setup as a profile"
                                    Description="Profiles keep their own dock items and look, for example Work, Gaming or Laptop. Switch from the dock's right-click menu or with a shortcut, or let one switch in by itself: when a number of displays is connected, while an app runs, or during set hours.">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="NewProfileName" Width="160" MinHeight="32" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                            <Button Content="Save" Click="OnSaveProfileClick" />
                        </StackPanel>
                    </ctl:SettingRow>

                </StackPanel>

                <!-- ============ Keyboard shortcuts ============ -->
                <StackPanel x:Name="KeyboardPage" Style="{StaticResource Page}">
                    <TextBlock Text="Keyboard shortcuts" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Win+number keys and global shortcuts for DockHub actions." Style="{StaticResource PageSubtitle}" />
                    <TextBlock Text="Taskbar keys" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE765;" Header="Win + number keys open dock apps"
                                    Description="Win+1…9 and Win+0 open or switch to the dock's apps, like the Windows taskbar. Add Shift for a new window, Ctrl+Shift to run as administrator, Alt for the jump list. Hold Win to see the numbers. Only when DockHub replaces the taskbar.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding WinNumberHotkeys}" />
                    </ctl:SettingRow>
                    <TextBlock Text="DockHub shortcuts" Style="{StaticResource SectionHeader}" />
                    <StackPanel x:Name="HotkeyRows" />

                </StackPanel>

                <!-- ============ Backup and troubleshooting ============ -->
                <StackPanel x:Name="BackupPage" Style="{StaticResource Page}">
                    <TextBlock Text="Backup and troubleshooting" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Keep a copy of your setup, and fix things when something goes wrong." Style="{StaticResource PageSubtitle}" />
                    <TextBlock Text="Backup and restore" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE78C;" Header="Export settings"
                                    Description="Saves your dock, widgets, notes and reminders to a .zip file.">
                        <Button Content="Export…" Click="OnExportSettingsClick" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE8B5;" Header="Import settings"
                                    Description="Replaces your current setup with a backup. The current one is saved to the backups folder first, then DockHub restarts.">
                        <Button Content="Import…" Click="OnImportSettingsClick" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE81C;" Header="Automatic backups"
                                    Description="DockHub keeps a copy of its settings from each of the last 7 days and uses it automatically if the settings file is ever damaged.">
                        <Button Content="Open folder" Click="OnOpenBackupsClick" />
                    </ctl:SettingRow>

                    <TextBlock Text="Maintenance" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE777;" Header="Restore Windows taskbar"
                                    Description="If the taskbar remains hidden due to an issue. (Command line: DockHub.exe --restore-taskbar)">
                        <Button Content="Restore" Click="OnRestoreTaskbarClick" />
                    </ctl:SettingRow>
                    <ctl:SettingRow x:Name="AutoRestartRow" Glyph="&#xE7BA;" Header="Restart after a crash is off" Visibility="Collapsed"
                                    Description="DockHub closed several times in a row, so Windows no longer starts it again after a crash.">
                        <Button Content="Turn back on" Click="OnEnableAutoRestartClick" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE72C;" Header="Restart DockHub">
                        <Button Content="Restart" Click="OnRestartClick" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE8B7;" Header="Settings and data folder" x:Name="ConfigFolderRow">
                        <Button Content="Open folder" Click="OnOpenConfigFolderClick" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE7E8;" Header="Exit DockHub" Description="Restores the Windows taskbar.">
                        <Button Content="Exit" Click="OnExitClick" />
                    </ctl:SettingRow>
                </StackPanel>

                <!-- ============ Taskbar ============ -->
                <StackPanel x:Name="TaskbarPage" Style="{StaticResource Page}">
                    <TextBlock Text="Taskbar" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="System items located at the start and end of the dock." Style="{StaticResource PageSubtitle}" />

                    <TextBlock Text="Left side" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE8A9;" Header="Start button" Description="Right-click: Windows quick link / power user menu (Win+X).">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowStartButton}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE721;" Header="Search">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowSearchButton}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE721;" Header="Search button opens"
                                    Description="The quick launcher finds apps, settings and DockHub commands, and does quick math. It also opens with its own shortcut."
                                    IsEnabled="{Binding ShowSearchButton}">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="SearchAction" Content="Windows Search"
                                             IsChecked="{Binding SearchButtonAction, Converter={StaticResource EnumEq}, ConverterParameter=WindowsSearch}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="SearchAction" Content="Quick launcher"
                                             IsChecked="{Binding SearchButtonAction, Converter={StaticResource EnumEq}, ConverterParameter=Launcher}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE7C4;" Header="Task view">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowTaskViewButton}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE7F4;" Header="Virtual desktop number"
                                    Description="Shows which desktop you are on when you have more than one. Scroll it to switch desktops, right-click to add or close one.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowDesktopIndicator}" />
                    </ctl:SettingRow>

                    <TextBlock Text="Applications" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE8A9;" Header="Show unpinned running apps"
                                    Description="Running applications that are not pinned to the dock appear after a separator. Right-click to pin or drag and drop anywhere.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowRunningApps}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE7F4;" Header="Apps from all desktops"
                                    Description="Lists open windows of every virtual desktop. Clicking one switches to its desktop.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RunningAppsAllDesktops}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE7B3;" Header="Peek at windows"
                                    Description="Resting the pointer on a window preview shows that window and fades the others. Scroll over a preview to switch between an app's windows.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding PreviewPeek}" />
                    </ctl:SettingRow>

                    <TextBlock Text="Right side" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE7EB;" Header="System tray" x:Name="TrayRow"
                                    Description="Icons of applications running in the background. Only available in 'DockHub' mode.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowTray}" />
                    </ctl:SettingRow>
                    <Border x:Name="TrayIconsCard" Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <TextBlock Text="Always visible icons" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Hidden icons are grouped under the ˄ button." Style="{StaticResource SettingDescription}" />
                            <ItemsControl x:Name="TrayIconList" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,12,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsPinned, Mode=OneWay}"
                                                      Click="OnTrayPinClick" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <ctl:SettingRow Glyph="&#xF2B7;" Header="Input language"
                                    Description="Shows the keyboard language (TUR, ENG) when more than one is installed. Click or scroll to switch, right-click for the list.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowKeyboardLayout}" IsEnabled="{Binding ShowTray}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE720;" Header="Microphone icon"
                                    Description="Click it to mute or unmute the microphone. When in use: shown while an app records, like Windows."
                                    IsEnabled="{Binding ShowTray}">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Mic" Content="When in use"
                                             IsChecked="{Binding MicrophoneIcon, Converter={StaticResource EnumEq}, ConverterParameter=WhenInUse}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Mic" Content="Always"
                                             IsChecked="{Binding MicrophoneIcon, Converter={StaticResource EnumEq}, ConverterParameter=Always}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Mic" Content="Off"
                                             IsChecked="{Binding MicrophoneIcon, Converter={StaticResource EnumEq}, ConverterParameter=Off}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE701;" Header="Network icon" Description="Connection status. Click for quick settings.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowNetworkIcon}" IsEnabled="{Binding ShowTray}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE995;" Header="Volume icon" Description="Scroll to change the volume, middle-click to mute, right-click to switch the output device.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowVolumeIcon}" IsEnabled="{Binding ShowTray}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE83F;" Header="Battery icon" Description="Charge level and time left. Only on devices with a battery.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowBatteryIcon}" IsEnabled="{Binding ShowTray}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE823;" Header="Clock" Description="Click to open calendar and notifications.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowClock}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE787;" Header="Show date">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ClockShowDate}" IsEnabled="{Binding ShowClock}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE916;" Header="Show seconds">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ClockShowSeconds}" IsEnabled="{Binding ShowClock}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xEA8F;" Header="Notifications next to the clock"
                                    Description="How many notifications wait in the notification center, and a moon while Do Not Disturb is on.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowNotificationIndicator}" IsEnabled="{Binding ShowClock}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE7F4;" Header="Show desktop button" Description="The slim strip at the far right of the dock.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowDesktopButton}" />
                    </ctl:SettingRow>
                </StackPanel>

                <!-- ============ Appearance ============ -->
                <StackPanel x:Name="AppearancePage" Style="{StaticResource Page}">
                    <TextBlock Text="Appearance" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Theme, glass effect, size, and layout." Style="{StaticResource PageSubtitle}" />

                    <ctl:MiniDockPreview x:Name="DockPreview" Margin="0,4,0,6" />

                    <TextBlock Text="Layout presets" Style="{StaticResource SectionHeader}" />
                    <UniformGrid x:Name="PresetPanel" Columns="4" Margin="0,0,0,6" />
                    <ctl:SettingRow Glyph="&#xE74E;" Header="Save current layout as a preset"
                                    Description="Keeps the look and the widgets of your dock as a preset you can apply again later.">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="NewPresetName" Width="160" MinHeight="32" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                            <Button Content="Save" Click="OnSavePresetClick" />
                        </StackPanel>
                    </ctl:SettingRow>

                    <TextBlock Text="Style" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE790;" Header="Theme">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Theme" Content="Dark"
                                             IsChecked="{Binding Theme, Converter={StaticResource EnumEq}, ConverterParameter=Dark}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Theme" Content="Light"
                                             IsChecked="{Binding Theme, Converter={StaticResource EnumEq}, ConverterParameter=Light}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Theme" Content="System"
                                             IsChecked="{Binding Theme, Converter={StaticResource EnumEq}, ConverterParameter=System}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xF570;" Header="Backdrop"
                                    Description="Blur: blurs content behind the dock. Acrylic: adds Windows translucent texture. Transparent: no blur, the desktop shows through. Solid: opaque. If Blur or Acrylic looks black on your PC (a graphics driver problem), pick Transparent.">
                        <Border Style="{StaticResource SegmentedHost}">
                            <WrapPanel>
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Backdrop" Content="Blur"
                                             IsChecked="{Binding Backdrop, Converter={StaticResource EnumEq}, ConverterParameter=Blur}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Backdrop" Content="Acrylic"
                                             IsChecked="{Binding Backdrop, Converter={StaticResource EnumEq}, ConverterParameter=Acrylic}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Backdrop" Content="Transparent"
                                             IsChecked="{Binding Backdrop, Converter={StaticResource EnumEq}, ConverterParameter=Transparent}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Backdrop" Content="Solid"
                                             IsChecked="{Binding Backdrop, Converter={StaticResource EnumEq}, ConverterParameter=Solid}" />
                            </WrapPanel>
                        </Border>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE706;" Header="Tint opacity" Description="Color layer overlay on glass.">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="200" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                    IsSnapToTickEnabled="True" TickFrequency="0.05" Value="{Binding TintOpacity}" />
                            <TextBlock Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding TintOpacity, Converter={StaticResource Percent}}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE945;" Header="Animations"
                                    Description="Reduced keeps short fades and turns off zoom, bounce and the genie effect. System follows Windows' animation effects setting.">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Motion" Content="System"
                                             IsChecked="{Binding Motion, Converter={StaticResource EnumEq}, ConverterParameter=System}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Motion" Content="Full"
                                             IsChecked="{Binding Motion, Converter={StaticResource EnumEq}, ConverterParameter=Full}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Motion" Content="Reduced"
                                             IsChecked="{Binding Motion, Converter={StaticResource EnumEq}, ConverterParameter=Reduced}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Motion" Content="Off"
                                             IsChecked="{Binding Motion, Converter={StaticResource EnumEq}, ConverterParameter=Off}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE7C4;" Header="Open app indicator" Description="Line: widens for the active app and several windows. Dots: one per window, up to three.">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Indicator" Content="Line"
                                             IsChecked="{Binding RunningIndicator, Converter={StaticResource EnumEq}, ConverterParameter=Line}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Indicator" Content="Dots"
                                             IsChecked="{Binding RunningIndicator, Converter={StaticResource EnumEq}, ConverterParameter=Dots}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Indicator" Content="Off"
                                             IsChecked="{Binding RunningIndicator, Converter={StaticResource EnumEq}, ConverterParameter=Off}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE80A;" Header="Widget style"
                                    Description="Cards puts every widget on a card of its own. Seamless sets them right on the dock, with a thin line between two widgets.">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="WidgetStyle" Content="Cards"
                                             IsChecked="{Binding WidgetStyle, Converter={StaticResource EnumEq}, ConverterParameter=Cards}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="WidgetStyle" Content="Seamless"
                                             IsChecked="{Binding WidgetStyle, Converter={StaticResource EnumEq}, ConverterParameter=Seamless}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE7B3;" Header="Card hover" Description="Widget card gently lights up when hovered.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HoverEffect}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE9A6;" Header="Even widget widths"
                                    Description="Widget cards use a few standard widths and round up to a common grid, so the dock keeps an even rhythm.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AlignWidgetWidths}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE8D2;" Header="Text size" x:Name="TextSizeRow"
                                    Description="Text in settings, widget panels and menus. System follows the Windows text size setting.">
                        <ComboBox x:Name="TextScaleCombo" Width="160" SelectionChanged="OnTextScaleChanged" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE790;" Header="Theme file"
                                    Description="Share your dock's look: colors, glass, size and shape in a .dockhub-theme file.">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Export…" Click="OnExportThemeClick" Margin="0,0,8,0" />
                            <Button Content="Import…" Click="OnImportThemeClick" />
                        </StackPanel>
                    </ctl:SettingRow>

                    <TextBlock Text="Size and shape" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE740;" Header="Size"
                                    Description="Size of the main dock. Docks on other displays can have their own size under Position.">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Size" Content="Small"
                                             IsChecked="{Binding Size, Converter={StaticResource EnumEq}, ConverterParameter=Small}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Size" Content="Medium"
                                             IsChecked="{Binding Size, Converter={StaticResource EnumEq}, ConverterParameter=Medium}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Size" Content="Large"
                                             IsChecked="{Binding Size, Converter={StaticResource EnumEq}, ConverterParameter=Large}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE8A9;" Header="Shape" Description="Floating: detached with rounded corners and margins. Attached: classic docked taskbar.">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Layout" Content="Floating"
                                             IsChecked="{Binding Layout, Converter={StaticResource EnumEq}, ConverterParameter=Floating}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Layout" Content="Attached"
                                             IsChecked="{Binding Layout, Converter={StaticResource EnumEq}, ConverterParameter=Attached}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE8C4;" Header="Edge margin" Description="Gap between the dock and the screen edge. Only applies to the floating shape."
                                    IsEnabled="{Binding Layout, Converter={StaticResource EnumEq}, ConverterParameter=Floating}">
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="MarginSlider" Width="200" Minimum="0" Maximum="24" SmallChange="1" LargeChange="2"
                                    IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding EdgeMargin}" />
                            <TextBlock Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding EdgeMargin, StringFormat={}{0:0} px}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE9A6;" Header="Width">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Width" Content="Full width"
                                             IsChecked="{Binding WidthMode, Converter={StaticResource EnumEq}, ConverterParameter=Full}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Width" Content="Fit content"
                                             IsChecked="{Binding WidthMode, Converter={StaticResource EnumEq}, ConverterParameter=Fit}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE8E3;" Header="Item alignment">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Align" Content="Start"
                                             IsChecked="{Binding Alignment, Converter={StaticResource EnumEq}, ConverterParameter=Start}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Align" Content="Center"
                                             IsChecked="{Binding Alignment, Converter={StaticResource EnumEq}, ConverterParameter=Center}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>

                    <TextBlock Text="Position" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE8A0;" Header="Screen edge">
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Edge" Content="Bottom"
                                             IsChecked="{Binding Edge, Converter={StaticResource EnumEq}, ConverterParameter=Bottom}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Edge" Content="Top"
                                             IsChecked="{Binding Edge, Converter={StaticResource EnumEq}, ConverterParameter=Top}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Edge" Content="Left"
                                             IsChecked="{Binding Edge, Converter={StaticResource EnumEq}, ConverterParameter=Left}" />
                                <RadioButton Style="{StaticResource SegmentedItem}" GroupName="Edge" Content="Right"
                                             IsChecked="{Binding Edge, Converter={StaticResource EnumEq}, ConverterParameter=Right}" />
                            </StackPanel>
                        </Border>
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE7F4;" Header="Main display"
                                    Description="Display for the main dock. Widgets and tray icons are shown here.">
                        <ComboBox x:Name="MonitorCombo" Width="260" DisplayMemberPath="Label" SelectionChanged="OnMonitorChanged" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE7F9;" Header="Show on all displays"
                                    Description="Adds a dock with your pinned apps, groups, Start and clock to every other connected display.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowOnAllDisplays}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE737;" Header="Running apps on their own display"
                                    Description="Each dock lists only the open apps whose windows are on its display."
                                    IsEnabled="{Binding ShowOnAllDisplays}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RunningAppsOnOwnDisplay}" />
                    </ctl:SettingRow>
                    <!-- One size row per other display (built in code, see LoadDisplaySizes) -->
                    <StackPanel x:Name="DisplaySizesPanel" />
                    <ctl:SettingRow Glyph="&#xE89F;" Header="Auto-hide"
                                    Description="The dock stays hidden until the mouse touches the screen edge. When disabled, windows do not overlap under the dock.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoHide}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE8A7;" Header="Only hide when a window overlaps"
                                    Description="With auto-hide on, the dock stays visible over the desktop and small windows, and slides away only while the active window covers its area.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SmartAutoHide}" IsEnabled="{Binding AutoHide}" />
                    </ctl:SettingRow>
                    <TextBlock Text="Top bar" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE8A1;" Header="Top bar"
                                    Description="A second, thin bar on the main display for widgets and a clock, like the menu bar on a Mac. Start, search, the tray and your apps stay on the dock. Move a widget there from its right-click menu (Show on) or in Dock items.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding TopBar.Enabled}" />
                    </ctl:SettingRow>
                    <StackPanel IsEnabled="{Binding TopBar.Enabled}">
                        <ctl:SettingRow Glyph="&#xE8A0;" Header="Bar edge" Description="The bar never shares the dock's edge; it moves to the opposite one.">
                            <Border Style="{StaticResource SegmentedHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentedItem}" GroupName="TopBarEdge" Content="Top"
                                                 IsChecked="{Binding TopBar.Edge, Converter={StaticResource EnumEq}, ConverterParameter=Top}" />
                                    <RadioButton Style="{StaticResource SegmentedItem}" GroupName="TopBarEdge" Content="Bottom"
                                                 IsChecked="{Binding TopBar.Edge, Converter={StaticResource EnumEq}, ConverterParameter=Bottom}" />
                                    <RadioButton Style="{StaticResource SegmentedItem}" GroupName="TopBarEdge" Content="Left"
                                                 IsChecked="{Binding TopBar.Edge, Converter={StaticResource EnumEq}, ConverterParameter=Left}" />
                                    <RadioButton Style="{StaticResource SegmentedItem}" GroupName="TopBarEdge" Content="Right"
                                                 IsChecked="{Binding TopBar.Edge, Converter={StaticResource EnumEq}, ConverterParameter=Right}" />
                                </StackPanel>
                            </Border>
                        </ctl:SettingRow>
                        <ctl:SettingRow Glyph="&#xE740;" Header="Bar size">
                            <Border Style="{StaticResource SegmentedHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentedItem}" GroupName="TopBarSize" Content="Small"
                                                 IsChecked="{Binding TopBar.Size, Converter={StaticResource EnumEq}, ConverterParameter=Small}" />
                                    <RadioButton Style="{StaticResource SegmentedItem}" GroupName="TopBarSize" Content="Medium"
                                                 IsChecked="{Binding TopBar.Size, Converter={StaticResource EnumEq}, ConverterParameter=Medium}" />
                                    <RadioButton Style="{StaticResource SegmentedItem}" GroupName="TopBarSize" Content="Large"
                                                 IsChecked="{Binding TopBar.Size, Converter={StaticResource EnumEq}, ConverterParameter=Large}" />
                                </StackPanel>
                            </Border>
                        </ctl:SettingRow>
                        <ctl:SettingRow Glyph="&#xE8A9;" Header="Bar shape">
                            <Border Style="{StaticResource SegmentedHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentedItem}" GroupName="TopBarLayout" Content="Floating"
                                                 IsChecked="{Binding TopBar.Layout, Converter={StaticResource EnumEq}, ConverterParameter=Floating}" />
                                    <RadioButton Style="{StaticResource SegmentedItem}" GroupName="TopBarLayout" Content="Attached"
                                                 IsChecked="{Binding TopBar.Layout, Converter={StaticResource EnumEq}, ConverterParameter=Attached}" />
                                </StackPanel>
                            </Border>
                        </ctl:SettingRow>
                        <ctl:SettingRow Glyph="&#xF570;" Header="Bar backdrop">
                            <ComboBox x:Name="TopBarBackdropCombo" Width="200" SelectionChanged="OnTopBarBackdropChanged" />
                        </ctl:SettingRow>
                        <ctl:SettingRow Glyph="&#xE7E7;" Header="Hide the bar automatically" Description="The bar slides off its edge and comes back when the pointer reaches it.">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding TopBar.AutoHide}" />
                        </ctl:SettingRow>
                        <ctl:SettingRow Glyph="&#xE917;" Header="Clock on the bar">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding TopBar.ShowClock}" />
                        </ctl:SettingRow>
                    </StackPanel>
                </StackPanel>

                <!-- ============ Dock items ============ -->
                <Grid x:Name="ItemsPage" Style="{StaticResource Page}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.ColumnSpan="3" Text="Dock items" Style="{StaticResource PageTitle}" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource PageSubtitle}"
                               Text="Apps, widgets, and separators are displayed in this order from left to right. Drag by the handle (or directly on the dock) to reorder." />

                    <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,0,0,12">
                        <Button Style="{StaticResource AccentButton}" Margin="0,0,8,0" Click="OnAddAppClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="12" />
                                <TextBlock Text="Add app" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,8,0" Click="OnOpenGalleryClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xECA5;" Style="{StaticResource IconText}" FontSize="12" />
                                <TextBlock Text="Add widget" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,8,0" Click="OnAddSeparatorClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE76F;" Style="{StaticResource IconText}" FontSize="12" />
                                <TextBlock Text="Add separator" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,8,0" Click="OnEditOnDockClick" ToolTip="Move, remove and resize items right on the dock">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" Style="{StaticResource IconText}" FontSize="12" />
                                <TextBlock Text="Edit on the dock" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnImportPinsClick" ToolTip="Adds applications pinned to the Windows taskbar">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource IconText}" FontSize="12" />
                                <TextBlock Text="Import taskbar pins" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Grid Margin="8,0,0,0" Width="210">
                            <TextBox x:Name="ItemFilterBox" VerticalContentAlignment="Center" Padding="28,0,8,0" MinHeight="32"
                                     TextChanged="OnItemFilterChanged" ToolTip="Filter by name (folder contents included)" />
                            <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="12" Margin="10,0,0,0" IsHitTestVisible="False"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Grid>
                    </WrapPanel>

                    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="6" VerticalAlignment="Top">
                        <ListBox x:Name="ItemList" Style="{StaticResource PlainListBox}" AllowDrop="True" MinHeight="120"
                                 SelectionChanged="OnItemSelectionChanged"
                                 PreviewMouseLeftButtonDown="OnItemListMouseDown"
                                 PreviewMouseMove="OnItemListMouseMove"
                                 DragOver="OnItemListDragOver"
                                 Drop="OnItemListDrop">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
                                    <Setter Property="Padding" Value="6,5" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE700;" Style="{StaticResource IconText}" FontSize="12" Width="18"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" Cursor="SizeAll" Tag="drag-handle" />
                                        <Border Grid.Column="1" Width="30" Height="30" CornerRadius="7" Margin="4,0,10,0"
                                                Background="{DynamicResource SubtleFillBrush}">
                                            <Grid>
                                                <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <Path Data="{Binding Glyph}" Stretch="Uniform" Width="15" Height="15" StrokeThickness="1.7"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Stroke="{Binding GlyphBrush}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,0,0,0">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE70E;" Width="24" Height="24" FontSize="10"
                                                    ToolTip="Move up" Click="OnMoveUpClick" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE70D;" Width="24" Height="24" FontSize="10"
                                                    ToolTip="Move down" Click="OnMoveDownClick" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" Width="24" Height="24" FontSize="10"
                                                    ToolTip="Remove" Click="OnRemoveItemClick" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <StackPanel Grid.Row="3" Grid.Column="2">
                        <TextBlock x:Name="EmptyDetail" Text="Select an item to view details." Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,8,0,0" />
                        <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,10">
                                <Border DockPanel.Dock="Left" Width="46" Height="46" CornerRadius="12" Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Image x:Name="DetailImage" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <Path x:Name="DetailGlyph" Stretch="Uniform" Width="22" Height="22" StrokeThickness="1.8"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Grid>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailTitle" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DetailSubtitle" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Preview -->
                            <Border x:Name="DetailPreviewHost" CornerRadius="16" Padding="8" HorizontalAlignment="Left" Margin="0,0,0,10"
                                    Background="{DynamicResource GalleryBackdropBrush}" Visibility="Collapsed" IsHitTestVisible="False" />

                            <!-- App -->
                            <StackPanel x:Name="AppDetail" Visibility="Collapsed">
                                <ctl:SettingRow Header="Display name" Description="Uses the application name if left empty.">
                                    <TextBox x:Name="AppNameBox" Width="220" LostFocus="OnAppNameChanged" KeyDown="OnAppNameKeyDown" />
                                </ctl:SettingRow>
                                <ctl:SettingRow x:Name="AppPathRow" Header="Target">
                                    <Button Content="Open location" Click="OnOpenAppLocationClick" />
                                </ctl:SettingRow>
                                <ctl:SettingRow Header="Launch arguments">
                                    <TextBox x:Name="AppArgsBox" Width="220" LostFocus="OnAppArgsChanged" />
                                </ctl:SettingRow>
                            </StackPanel>

                            <!-- Widget -->
                            <StackPanel x:Name="WidgetDetail" Visibility="Collapsed">
                                <ctl:SettingRow Header="Variant" Description="Appearance style of the widget on the dock.">
                                    <ComboBox x:Name="VariantCombo" Width="200" DisplayMemberPath="Name" SelectionChanged="OnVariantChanged" />
                                </ctl:SettingRow>
                                <ctl:SettingRow x:Name="WidgetDisplayRow" Header="Show on" Description="The dock this widget sits on. On a display that is disconnected, it moves to the main dock until the display is back.">
                                    <ComboBox x:Name="WidgetDisplayCombo" Width="200" DisplayMemberPath="Label" SelectionChanged="OnWidgetDisplayChanged" />
                                </ctl:SettingRow>
                                <ContentControl x:Name="WidgetSettingsHost" Focusable="False" />
                            </StackPanel>

                            <!-- Group / Folder -->
                            <StackPanel x:Name="GroupDetail" Visibility="Collapsed">
                                <ctl:SettingRow Header="Folder name" Description="The name displayed on the dock and in tooltips.">
                                    <TextBox x:Name="GroupNameBox" Width="220" LostFocus="OnGroupNameChanged" KeyDown="OnGroupNameKeyDown" />
                                </ctl:SettingRow>
                                <ctl:SettingRow Header="Folder color" Description="Accent color applied to the folder.">
                                    <ComboBox x:Name="GroupAccentCombo" Width="200" SelectionChanged="OnGroupAccentChanged" />
                                </ctl:SettingRow>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ============ Widget gallery ============ -->
                <StackPanel x:Name="GalleryPage" Style="{StaticResource Page}">
                    <TextBlock Text="Widget gallery" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Press Add, or drag a widget's card onto the dock. Right-click a widget on the dock to change its layout or open its settings."
                               Style="{StaticResource PageSubtitle}" />
                    <WrapPanel Margin="0,0,0,12">
                        <Grid Width="260" Margin="0,0,12,6">
                            <TextBox x:Name="GallerySearchBox" MinHeight="32" VerticalContentAlignment="Center" Padding="30,0,8,0"
                                     TextChanged="OnGallerySearchChanged" PreviewKeyDown="OnGallerySearchKeyDown" />
                            <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="12" Margin="11,0,0,0" IsHitTestVisible="False"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock x:Name="GallerySearchHint" Text="Search widgets" Margin="30,0,0,0" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Grid>
                        <Button Margin="0,0,8,6" Click="OnInstallWebWidgetClick" ToolTip="Install a .dockwidget package (HTML/JavaScript widget)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource IconText}" FontSize="12" />
                                <TextBlock Text="Install widget…" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,8,6" Click="OnInstallFromLinkClick" ToolTip="Install a web widget from a manifest.json, .dockwidget or GitHub folder link">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71B;" Style="{StaticResource IconText}" FontSize="12" />
                                <TextBlock Text="Install from link…" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,0,6" Click="OnOpenWidgetsFolderClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" Style="{StaticResource IconText}" FontSize="12" />
                                <TextBlock Text="Open widgets folder" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <Border x:Name="WidgetLinkCard" Style="{StaticResource SettingCard}" Visibility="Collapsed" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Install from link" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Paste a link to a manifest.json, a .dockwidget file or a GitHub folder that contains a widget. You see its permissions before anything is installed."
                                       Style="{StaticResource SettingDescription}" />
                            <DockPanel Margin="0,10,0,0">
                                <Button x:Name="WidgetLinkInstallButton" DockPanel.Dock="Right" Content="Install" Margin="8,0,0,0" Padding="14,4"
                                        Style="{StaticResource AccentButton}" Click="OnInstallLinkConfirmClick" />
                                <TextBox x:Name="WidgetLinkBox" KeyDown="OnWidgetLinkKeyDown" />
                            </DockPanel>
                            <TextBlock x:Name="WidgetLinkStatus" Style="{StaticResource SettingDescription}" Margin="0,6,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <WrapPanel x:Name="GalleryChips" Margin="0,0,0,4" />
                    <TextBlock x:Name="GalleryEmpty" Style="{StaticResource SettingDescription}" Margin="2,14,0,0" Visibility="Collapsed" />
                    <StackPanel x:Name="GalleryPanel" />
                </StackPanel>

                <!-- ============ About ============ -->
                <StackPanel x:Name="AboutPage" Style="{StaticResource Page}">
                    <TextBlock Text="About" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource SettingCard}" Padding="20" Margin="0,12,0,4">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/DockHub;component/Assets/DockHub.ico" Width="56" Height="56"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="DockHub" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock x:Name="AboutVersion" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="A widget-powered dock that replaces the Windows taskbar." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Updates" Style="{StaticResource SectionHeader}" />
                    <Border x:Name="UpdateCard" Style="{StaticResource SettingCard}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="UpdateTitle" Style="{StaticResource SettingTitle}" />
                            <TextBlock x:Name="UpdateNotes" Style="{StaticResource SettingDescription}" TextWrapping="Wrap" MaxHeight="160" Margin="0,4,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="InstallUpdateButton" Content="Download and install" Click="OnInstallUpdateClick" />
                                <Button Content="Release notes" Margin="8,0,0,0" Click="OnReleaseNotesClick" />
                                <TextBlock x:Name="UpdateProgress" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ctl:SettingRow x:Name="UpdateStatusRow" Glyph="&#xE895;" Header="Check for updates">
                        <Button x:Name="CheckUpdatesButton" Content="Check now" Click="OnCheckUpdatesClick" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE823;" Header="Check automatically" Description="Once a day, DockHub asks GitHub for the latest release. Nothing else is sent.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CheckForUpdates}" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE9D9;" Header="Include pre-releases" Description="Also offer beta versions.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IncludePrereleases}" />
                    </ctl:SettingRow>

                    <TextBlock Text="Open source software &amp; data used" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE7F4;" Header="ManagedShell" Description="Task list, system tray, and AppBar services (Apache-2.0).">
                        <Button Content="GitHub" Tag="https://github.com/cairoshell/ManagedShell" Click="OnOpenLinkClick" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE782;" Header="RetroBar" Description="Start menu and tray interaction patterns (Apache-2.0).">
                        <Button Content="GitHub" Tag="https://github.com/dremin/RetroBar" Click="OnOpenLinkClick" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xE753;" Header="Open-Meteo" Description="Weather and geocoding data (CC BY 4.0).">
                        <Button Content="Open website" Tag="https://open-meteo.com/" Click="OnOpenLinkClick" />
                    </ctl:SettingRow>
                    <TextBlock Text="Troubleshooting" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE7BE;" Header="Welcome screen" Description="The first-run tour: taskbar mode, screen edge, a layout and a few tips.">
                        <Button Content="Show again" Click="OnShowWelcomeClick" />
                    </ctl:SettingRow>
                    <ctl:SettingRow Glyph="&#xEBE8;" Header="Copy diagnostics"
                                    Description="Copies how DockHub sees open windows and pinned apps to the clipboard (and log.txt). Useful when an app doesn't show up on the dock or its icon is missing.">
                        <Button x:Name="DiagnosticsButton" Content="Copy" Click="OnCopyDiagnosticsClick" />
                    </ctl:SettingRow>
                    <ctl:SettingRow x:Name="ReportProblemRow" Glyph="&#xE939;" Header="Report a problem"
                                    Description="Opens a bug report on GitHub with your DockHub and Windows versions, language and widgets filled in, and copies the diagnostics report.">
                        <Button Content="Report…" Click="OnReportProblemClick" />
                    </ctl:SettingRow>
                    <ctl:SettingRow x:Name="LastCrashRow" Glyph="&#xE7BA;" Header="Last crash" Visibility="Collapsed">
                        <Button x:Name="CopyCrashButton" Content="Copy details" Click="OnCopyCrashClick" />
                    </ctl:SettingRow>
                    <TextBlock Text="Tips" Style="{StaticResource SectionHeader}" />
                    <ctl:SettingRow Glyph="&#xE962;" Header="Right-click the dock" Description="Add widgets, pin apps, change position, and toggle auto-hide." />
                    <ctl:SettingRow Glyph="&#xE8A7;" Header="Window previews" Description="Hover a running app to preview its windows. Click a preview to switch to it, middle-click to close it." />
                    <ctl:SettingRow Glyph="&#xE7C9;" Header="Mouse wheel" Description="Scroll horizontally when the dock overflows." />
                    <ctl:SettingRow Glyph="&#xE8A7;" Header="Middle click / Shift+click" Description="Opens a new window of the application." />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
