<!--
    Implicit (DataType) templates for widget settings objects.
    Settings window puts the selected item's settings object into a ContentControl; WPF selects the template by type.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:CustomDock.Controls"
                    xmlns:w="clr-namespace:CustomDock.Widgets"
                    xmlns:svc="clr-namespace:CustomDock.Services">

    <!-- Clock -->
    <DataTemplate DataType="{x:Type w:ClockSettings}">
        <StackPanel>
            <ctl:SettingRow Header="24-hour format" Description="When disabled, 12-hour format (AM/PM) is used.">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Use24Hour}" />
            </ctl:SettingRow>
            <ctl:SettingRow Header="Show seconds">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowSeconds}" />
            </ctl:SettingRow>
            <ctl:SettingRow Header="Date format">
                <ComboBox Width="220" ItemsSource="{x:Static w:ClockSettings.DateFormatOptions}"
                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DateFormat}" />
            </ctl:SettingRow>
        </StackPanel>
    </DataTemplate>

    <!-- Focus -->
    <DataTemplate DataType="{x:Type w:FocusSettings}">
        <StackPanel>
            <ctl:SettingRow Header="Focus duration">
                <ComboBox Width="160" ItemsSource="{x:Static w:FocusSettings.FocusOptions}"
                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FocusMinutes}" />
            </ctl:SettingRow>
            <ctl:SettingRow Header="Break duration">
                <ComboBox Width="160" ItemsSource="{x:Static w:FocusSettings.BreakOptions}"
                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding BreakMinutes}" />
            </ctl:SettingRow>
            <ctl:SettingRow Header="Auto-start next phase" Description="Starts break when focus ends, and focus when break ends.">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoStartNext}" />
            </ctl:SettingRow>
            <ctl:SettingRow Header="Long break" Description="Take a long break instead of a short one after this many focus sessions.">
                <ComboBox Width="130" ItemsSource="{x:Static w:FocusSettings.SessionCountOptions}"
                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SessionsBeforeLongBreak}" />
            </ctl:SettingRow>
            <ctl:SettingRow Header="Long break duration">
                <ComboBox Width="130" ItemsSource="{x:Static w:FocusSettings.LongBreakOptions}"
                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LongBreakMinutes}" />
            </ctl:SettingRow>
        </StackPanel>
    </DataTemplate>

    <!-- Countdown -->
    <DataTemplate DataType="{x:Type w:CountdownSettings}">
        <StackPanel>
            <ctl:SettingRow Header="Duration">
                <ComboBox Width="160" ItemsSource="{x:Static w:CountdownSettings.Presets}"
                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Seconds}" />
            </ctl:SettingRow>
            <ctl:SettingRow Header="Label">
                <TextBox Width="200" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
            </ctl:SettingRow>
        </StackPanel>
    </DataTemplate>

    <!-- Alarm -->
    <DataTemplate DataType="{x:Type w:AlarmSettings}">
        <StackPanel>
            <ctl:SettingRow Header="Alarm enabled">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" />
            </ctl:SettingRow>
            <ctl:SettingRow Header="Time" Description="In HH:mm format.">
                <TextBox Width="90" HorizontalContentAlignment="Center" Text="{Binding Time}" />
            </ctl:SettingRow>
            <ctl:SettingRow Header="Label">
                <TextBox Width="200" Text="{Binding Label}" />
            </ctl:SettingRow>
            <ctl:SettingRow Header="Repeat daily">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RepeatDaily}" />
            </ctl:SettingRow>
        </StackPanel>
    </DataTemplate>

    <!-- Time progress -->
    <DataTemplate DataType="{x:Type w:TimeProgressSettings}">
        <StackPanel>
            <ctl:SettingRow Header="Period" Description="You can also change this by right-clicking the widget.">
                <ComboBox Width="140" ItemsSource="{x:Static w:TimeProgressSettings.ModeOptions}"
                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Mode}" />
            </ctl:SettingRow>
        </StackPanel>
    </DataTemplate>

    <!-- Hydration -->
    <DataTemplate DataType="{x:Type svc:HydrationSettings}">
        <StackPanel>
            <ctl:SettingRow Header="Daily goal" Description="Number of glasses.">
                <StackPanel Orientation="Horizontal">
                    <Slider Width="180" Minimum="1" Maximum="20" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding DailyGoal}" />
                    <TextBlock Width="36" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding DailyGoal}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </ctl:SettingRow>
            <ctl:SettingRow Header="Glass size">
                <ComboBox Width="140" ItemsSource="{x:Static w:WidgetOptions.GlassSizes}"
                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding GlassMl}" />
            </ctl:SettingRow>
            <ctl:SettingRow Header="Reminder interval" Description="Reminds after this duration since the last glass; widget counts down to this duration.">
                <ComboBox Width="140" ItemsSource="{x:Static w:WidgetOptions.HydrationIntervals}"
                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding IntervalMinutes}" />
            </ctl:SettingRow>
            <ctl:SettingRow Header="Notifications">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotificationsEnabled}" />
            </ctl:SettingRow>
            <ctl:SettingRow Header="Active hours" Description="No notifications are sent outside these hours.">
                <StackPanel Orientation="Horizontal" IsEnabled="{Binding NotificationsEnabled}">
                    <ComboBox Width="90" ItemsSource="{x:Static w:WidgetOptions.StartHours}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding StartHour}" />
                    <TextBlock Text="–" Margin="8,0" VerticalAlignment="Center" />
                    <ComboBox Width="90" ItemsSource="{x:Static w:WidgetOptions.EndHours}"
                              DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding EndHour}" />
                </StackPanel>
            </ctl:SettingRow>
        </StackPanel>
    </DataTemplate>

    <!-- Note -->
    <DataTemplate DataType="{x:Type w:NotesSettings}">
        <StackPanel>
            <ctl:SettingRow Header="Color">
                <ComboBox Width="140" ItemsSource="{x:Static w:NotesSettings.ColorOptions}"
                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Color}" />
            </ctl:SettingRow>
            <ctl:SettingRow Header="Card width" Description="Width of the preview card on the dock.">
                <ComboBox Width="140" ItemsSource="{x:Static w:NotesSettings.WidthOptions}"
                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Width}" />
            </ctl:SettingRow>
            <ctl:SettingRow Header="Font size" Description="Size of text on the sticky note.">
                <StackPanel Orientation="Horizontal">
                    <Slider Width="160" Minimum="14" Maximum="28" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding FontSize}" />
                    <TextBlock Width="36" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding FontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </ctl:SettingRow>
        </StackPanel>
    </DataTemplate>

    <!-- Media -->
    <DataTemplate DataType="{x:Type w:MediaSettings}">
        <StackPanel>
            <ctl:SettingRow Header="Hide when idle" Description="Hides widget when there is no active media session.">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HideWhenIdle}" />
            </ctl:SettingRow>
        </StackPanel>
    </DataTemplate>

    <!-- CPU & Memory -->
    <DataTemplate DataType="{x:Type w:SystemSettings}">
        <StackPanel>
            <ctl:SettingRow Header="Update interval" Description="A longer interval uses less CPU.">
                <ComboBox Width="140" ItemsSource="{x:Static w:WidgetOptions.SystemIntervals}"
                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding UpdateIntervalSeconds}" />
            </ctl:SettingRow>
        </StackPanel>
    </DataTemplate>

    <!-- Calendar -->
    <DataTemplate DataType="{x:Type w:CalendarSettings}">
        <StackPanel>
            <ctl:SettingRow Header="Calendar links"
                            Description="One iCal (.ics) link per line. Google Calendar: Settings › your calendar › Secret address in iCal format. Outlook: Settings › Calendar › Shared calendars › Publish a calendar › ICS.">
                <TextBox Width="320" Height="72" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                         Text="{Binding Feeds, UpdateSourceTrigger=LostFocus}" />
            </ctl:SettingRow>
            <ctl:SettingRow Header="Remind me" Description="A notification before each event.">
                <ComboBox Width="160" ItemsSource="{x:Static w:WidgetOptions.CalendarReminders}"
                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding RemindMinutes}" />
            </ctl:SettingRow>
        </StackPanel>
    </DataTemplate>

    <!-- Exchange rates -->
    <DataTemplate DataType="{x:Type w:CurrencySettings}">
        <StackPanel>
            <ctl:SettingRow Header="Base currency">
                <ComboBox Width="120" ItemsSource="{x:Static svc:CurrencyService.Supported}" SelectedItem="{Binding Base}" />
            </ctl:SettingRow>
            <ctl:SettingRow Header="Show against" Description="Currency codes separated by commas, for example TRY, EUR, GBP.">
                <TextBox Width="200" Text="{Binding Targets, UpdateSourceTrigger=LostFocus}" />
            </ctl:SettingRow>
        </StackPanel>
    </DataTemplate>

    <!-- Folder stack -->
    <DataTemplate DataType="{x:Type w:StackSettings}">
        <StackPanel>
            <ctl:SettingRow Header="Folder" Description="Leave empty for your Downloads folder.">
                <TextBox Width="300" Text="{Binding Folder, UpdateSourceTrigger=LostFocus}" />
            </ctl:SettingRow>
        </StackPanel>
    </DataTemplate>

    <!-- AI usage -->
    <DataTemplate DataType="{x:Type w:AIUsageSettings}">
        <StackPanel>
            <ctl:SettingRow Header="Check usage every" Description="Each check runs the Claude CLI briefly in the background. Right-click the widget to refresh now.">
                <ComboBox Width="140" ItemsSource="{x:Static w:WidgetOptions.AIUsageIntervals}"
                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding RefreshMinutes}" />
            </ctl:SettingRow>
        </StackPanel>
    </DataTemplate>

    <!-- Status -->
    <DataTemplate DataType="{x:Type w:StatusSettings}">
        <StackPanel>
            <ctl:SettingRow Header="Battery" Description="Hidden on computers without a battery.">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowBattery}" />
            </ctl:SettingRow>
            <ctl:SettingRow Header="Disk usage (system drive)">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowDisk}" />
            </ctl:SettingRow>
            <ctl:SettingRow Header="Memory">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowMemory}" />
            </ctl:SettingRow>
            <ctl:SettingRow Header="CPU">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowCpu}" />
            </ctl:SettingRow>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
