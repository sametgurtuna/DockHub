<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- High contrast: every brush maps to a Windows system color by role (generated from Dark.xaml). -->
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentMagentaBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentOrangeBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentPinkBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentRedBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentYellowBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="BlueTrackBrush" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="ClockFaceDayBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="ClockFaceNightBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="CloudBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="ControlBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="DockHoverBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="DockPressedBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="DockSolidBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="DockTintBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="DropCaretBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="GalleryBackdropBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="GreenTrackBrush" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="HydrationCardBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="IndicatorBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="MagentaTrackBrush" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="NoteBlueBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="NoteGreenBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="NoteOrangeBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="NotePinkBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="NotePurpleBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="NoteRedBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="NoteTextBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="NoteYellowBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="OrangeTrackBrush" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="PopupBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="SubtleFillBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="TextOnColorBrush" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="TickOffBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="TickOnBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="TrackBrush" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{x:Static SystemColors.WindowColor}" />
    <x:Static x:Key="DockBorderColor" Member="SystemColors.WindowTextColor" />
</ResourceDictionary>
