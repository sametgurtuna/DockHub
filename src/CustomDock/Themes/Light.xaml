<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= Dock ================= -->
    <SolidColorBrush x:Key="DockTintBrush" Color="#FFF2F2F5" />
    <SolidColorBrush x:Key="DockSolidBrush" Color="#FFF3F3F5" />
    <Color x:Key="DockBorderColor">#FFD2D2D8</Color>
    <SolidColorBrush x:Key="DockHoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="DockPressedBrush" Color="#0C000000" />
    <SolidColorBrush x:Key="IndicatorBrush" Color="#99000000" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#24000000" />
    <SolidColorBrush x:Key="DropCaretBrush" Color="#FF1D1D1F" />

    <!-- ================= Widget Cards ================= -->
    <SolidColorBrush x:Key="CardBrush" Color="#D6FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#14000000" />
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#26000000" />
    <SolidColorBrush x:Key="GalleryBackdropBrush" Color="#FFE8E8EC" />

    <LinearGradientBrush x:Key="HydrationCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF5B9CE8" Offset="0" />
        <GradientStop Color="#FF3571C2" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NoteYellowBrush" Color="#FFF5D366" />
    <SolidColorBrush x:Key="NoteGreenBrush" Color="#FFA9DDA6" />
    <SolidColorBrush x:Key="NoteBlueBrush" Color="#FF95C5F5" />
    <SolidColorBrush x:Key="NotePinkBrush" Color="#FFF59AA4" />
    <SolidColorBrush x:Key="NotePurpleBrush" Color="#FFDDAEEF" />
    <SolidColorBrush x:Key="NoteOrangeBrush" Color="#FFF7B372" />
    <SolidColorBrush x:Key="NoteRedBrush" Color="#FFF59AA4" />
    <SolidColorBrush x:Key="NoteTextBrush" Color="#FF1C1C1E" />

    <!-- ================= Text ================= -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1D1D1F" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF6E6E73" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FFA1A1A6" />
    <SolidColorBrush x:Key="TextOnColorBrush" Color="#FFFFFFFF" />

    <!-- ================= Indicators ================= -->
    <SolidColorBrush x:Key="TrackBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="TickOffBrush" Color="#FFD6D6DB" />
    <SolidColorBrush x:Key="TickOnBrush" Color="#FF2C2C2E" />
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#0D000000" />
    <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="#17000000" />
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0D000000" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#14000000" />
    <SolidColorBrush x:Key="PopupBrush" Color="#FCFBFBFC" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#33000000" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#5C000000" />
    <SolidColorBrush x:Key="CloudBrush" Color="#FFA9B2BF" />

    <!-- ================= Accent Colors ================= -->
    <SolidColorBrush x:Key="AccentGreenBrush" Color="#FF28B446" />
    <SolidColorBrush x:Key="AccentOrangeBrush" Color="#FFF58A00" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="#FF007AFF" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="#FF1AA3D9" />
    <SolidColorBrush x:Key="AccentMagentaBrush" Color="#FFB93FDB" />
    <SolidColorBrush x:Key="AccentPinkBrush" Color="#FFF2338A" />
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="#FF9B45D6" />
    <SolidColorBrush x:Key="AccentYellowBrush" Color="#FFE0AE00" />
    <SolidColorBrush x:Key="AccentRedBrush" Color="#FFF0362B" />
    <SolidColorBrush x:Key="MagentaTrackBrush" Color="#33B93FDB" />
    <SolidColorBrush x:Key="BlueTrackBrush" Color="#33007AFF" />
    <SolidColorBrush x:Key="GreenTrackBrush" Color="#3328B446" />
    <SolidColorBrush x:Key="OrangeTrackBrush" Color="#33F58A00" />

    <!-- Analog Clock -->
    <SolidColorBrush x:Key="ClockFaceDayBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ClockFaceNightBrush" Color="#FF2C2C30" />

    <!-- ================= Settings Window ================= -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#10000000" />
    <SolidColorBrush x:Key="ControlBrush" Color="#FFFBFBFB" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FFE1E1E1" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF005FB8" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#26005FB8" />
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#FFC4C4CA" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#1FF58A00" />

</ResourceDictionary>
