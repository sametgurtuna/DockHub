<w:WidgetBase x:Class="CustomDock.Widgets.AudioWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:CustomDock.Widgets"
              xmlns:ctl="clr-namespace:CustomDock.Controls"
              Cursor="Hand"
              Background="Transparent">
    <Grid Background="Transparent">
        <!-- Compact View (Icon + Device Name + Percent) -->
        <StackPanel x:Name="Layout_compact" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource SurfaceLightBrush}" Margin="0,0,8,0">
                <Path x:Name="CompactIcon" Width="14" Height="14" Stretch="Uniform"
                      Fill="{DynamicResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" MaxWidth="110">
                <TextBlock x:Name="CompactDeviceName" Style="{StaticResource TitleText}" FontSize="12" />
                <TextBlock x:Name="CompactVolumeText" Style="{StaticResource CaptionText}" Foreground="{DynamicResource AccentCyanBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Bar View (Icon + Device Name + Volume Bar + Percent) -->
        <Grid x:Name="Layout_slider" Width="168" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="38" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="18" />
                <RowDefinition Height="16" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="2" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource SurfaceLightBrush}"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                <Path x:Name="SliderIcon" Width="13" Height="13" Stretch="Uniform"
                      Fill="{DynamicResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock x:Name="SliderDeviceName" Grid.Column="1" Style="{StaticResource TitleText}" FontSize="11.5"
                        VerticalAlignment="Center" Margin="6,0,0,0" />

            <Grid x:Name="SliderBarTrack" Grid.Row="1" Grid.Column="1" Height="4.5" VerticalAlignment="Center" Margin="6,0,0,0">
                <Border CornerRadius="2.25" Background="{DynamicResource BlueTrackBrush}" />
                <Border x:Name="SliderBar" CornerRadius="2.25" HorizontalAlignment="Left" Width="0" Background="{DynamicResource AccentCyanBrush}" />
            </Grid>

            <TextBlock x:Name="SliderVolumeText" Grid.Row="1" Grid.Column="2" Style="{StaticResource CaptionText}"
                        Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- Audio Mixer Popup (EarTrumpet / Windows 11 style mixer) -->
        <Popup x:Name="MixerPopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None" Placement="Top">
            <Border x:Name="MixerBorder" CornerRadius="14" Padding="14,12" BorderThickness="1" Margin="8" Width="310"
                    Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
                    PreviewMouseWheel="OnMixerBorderPreviewMouseWheel">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Direction="270" />
                </Border.Effect>
                <StackPanel x:Name="MixerPanel" />
            </Border>
        </Popup>
    </Grid>
</w:WidgetBase>
