<w:WidgetBase x:Class="CustomDock.Widgets.BatteryDevicesWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:CustomDock.Widgets"
              xmlns:ctl="clr-namespace:CustomDock.Controls"
              Cursor="Hand"
              Background="Transparent">
    <Grid Background="Transparent">
        <!-- Single / Primary Device View -->
        <StackPanel x:Name="Layout_single" Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="28" Height="28" Margin="0,0,8,0">
                <ctl:RingGauge x:Name="SingleBatteryRing" Thickness="3" Fill="{DynamicResource AccentGreenBrush}" Track="{DynamicResource GreenTrackBrush}" />
                <Path x:Name="SingleIcon" Width="12" Height="12" Stretch="Uniform"
                      Fill="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <StackPanel VerticalAlignment="Center" MaxWidth="110">
                <TextBlock x:Name="SingleDeviceName" Style="{StaticResource TitleText}" FontSize="12" Text="No Devices" />
                <TextBlock x:Name="SingleBatteryText" Style="{StaticResource CaptionText}" Text="—" />
            </StackPanel>
        </StackPanel>

        <!-- Multi Device View (Side by side) -->
        <StackPanel x:Name="Layout_multi" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Populated dynamically in code-behind -->
            <ItemsControl x:Name="MultiDevicesList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock x:Name="MultiEmptyText" Style="{StaticResource CaptionText}" Text="No connected devices" Visibility="Collapsed" />
        </StackPanel>

        <!-- All devices, reorderable; the top one is shown on the dock -->
        <Popup x:Name="DevicesPopup" StaysOpen="True" AllowsTransparency="True" PopupAnimation="None" Placement="Top">
            <ctl:WidgetFlyout Title="Device batteries" Icon="&#xE83F;" Size="Standard" Padding="12,10" MouseLeftButtonUp="OnPopupMouseUp">
                <ctl:WidgetFlyout.HeaderActions>
                    <Button Style="{StaticResource CardIconButton}" Content="&#xE72C;" ToolTip="Refresh" Click="OnRefreshClick" />
                </ctl:WidgetFlyout.HeaderActions>
                <ctl:WidgetFlyout.Footer>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"
                               Text="The device at the top is the one shown on the dock." />
                </ctl:WidgetFlyout.Footer>
                <StackPanel x:Name="DeviceList" />
            </ctl:WidgetFlyout>
        </Popup>
    </Grid>
</w:WidgetBase>
