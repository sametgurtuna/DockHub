<w:WidgetBase x:Class="CustomDock.Widgets.CalendarWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:CustomDock.Widgets"
              Cursor="Hand"
              Background="Transparent">
    <Grid Background="Transparent">
        <!-- Next event -->
        <StackPanel x:Name="Layout_next" Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="DateBadge" Width="30" Height="32" CornerRadius="6" Margin="0,0,9,0" Background="{DynamicResource SubtleFillBrush}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="BadgeMonth" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource AccentRedBrush}" />
                    <TextBlock x:Name="BadgeDay" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-2,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>
            <StackPanel VerticalAlignment="Center" Width="150">
                <TextBlock x:Name="NextTitle" Style="{StaticResource TitleText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="NextTime" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="JoinButton" Content="Join" Margin="8,0,0,0" Padding="10,2" Click="OnJoinClick" Visibility="Collapsed"
                    Style="{DynamicResource AccentButton}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Only the time until the next event -->
        <StackPanel x:Name="Layout_compact" VerticalAlignment="Center" MinWidth="56">
            <TextBlock x:Name="CompactTime" Style="{StaticResource TitleText}" FontSize="13" HorizontalAlignment="Center" />
            <TextBlock x:Name="CompactLabel" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" MaxWidth="90" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Popup x:Name="AgendaPopup" StaysOpen="True" AllowsTransparency="True" PopupAnimation="None" Placement="Top">
            <Border CornerRadius="14" Padding="12" BorderThickness="1" Margin="8" Width="330"
                    Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupBorderBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Direction="270" />
                </Border.Effect>
                <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AgendaList" />
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</w:WidgetBase>
