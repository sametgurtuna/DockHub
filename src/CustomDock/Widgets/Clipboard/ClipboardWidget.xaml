<w:WidgetBase x:Class="CustomDock.Widgets.ClipboardWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:CustomDock.Widgets"
              xmlns:ctl="clr-namespace:CustomDock.Controls"
              Cursor="Hand"
              Background="Transparent">
    <Grid Background="Transparent">
        <!-- Icon only -->
        <Border x:Name="Layout_icon" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource SubtleFillBrush}">
            <Grid>
                <Path x:Name="IconPath" Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource AccentCyanBrush}"
                      StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Border x:Name="CountBadge" Background="{DynamicResource AccentCyanBrush}" CornerRadius="7" MinWidth="14" Height="14"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0" Padding="3,0" Visibility="Collapsed">
                    <TextBlock x:Name="CountText" FontSize="9" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- Latest entry -->
        <StackPanel x:Name="Layout_latest" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource SubtleFillBrush}" Margin="0,0,8,0">
                <Path x:Name="LatestIconPath" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource AccentCyanBrush}"
                      StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Border>
            <StackPanel VerticalAlignment="Center" Width="130">
                <TextBlock Text="Clipboard" Style="{StaticResource TitleText}" FontSize="12" />
                <TextBlock x:Name="LatestText" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>

        <Popup x:Name="HistoryPopup" StaysOpen="True" AllowsTransparency="True" PopupAnimation="None" Placement="Top">
            <ctl:WidgetFlyout Title="Clipboard history" Icon="&#xE77F;" Size="Standard" Padding="12,10">
                <ctl:WidgetFlyout.HeaderActions>
                    <Button Content="Clear" Click="OnClearClick" Padding="10,2" />
                </ctl:WidgetFlyout.HeaderActions>
                <ctl:WidgetFlyout.Footer>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"
                               Text="Click an entry to copy it again. Kept only while DockHub runs; passwords from password managers are never recorded." />
                </ctl:WidgetFlyout.Footer>
                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="EntryList" />
                </ScrollViewer>
            </ctl:WidgetFlyout>
        </Popup>
    </Grid>
</w:WidgetBase>
