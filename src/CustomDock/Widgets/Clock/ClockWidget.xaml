<w:WidgetBase x:Class="CustomDock.Widgets.ClockWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:CustomDock.Widgets"
              xmlns:ctl="clr-namespace:CustomDock.Controls">
    <Grid Background="Transparent">
        <!-- Saat: analog ikon + saat + tarih -->
        <StackPanel x:Name="Layout_analog" Orientation="Horizontal" MinWidth="118">
            <ctl:AnalogClock x:Name="Analog" Width="30" Height="30" VerticalAlignment="Center" AlwaysDark="True"
                             Accent="{DynamicResource AccentOrangeBrush}"
                             DayFace="{DynamicResource ClockFaceDayBrush}" NightFace="{DynamicResource ClockFaceNightBrush}" />
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="AnalogTime" Style="{StaticResource ValueText}" />
                <TextBlock x:Name="AnalogDate" Style="{StaticResource CaptionText}" />
            </StackPanel>
        </StackPanel>

        <!-- Dijital -->
        <StackPanel x:Name="Layout_digital" MinWidth="84" VerticalAlignment="Center">
            <TextBlock x:Name="DigitalTime" Style="{StaticResource ValueText}" FontSize="19" LineHeight="22" HorizontalAlignment="Center" />
            <TextBlock x:Name="DigitalDate" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Takvim: tarih bloğu + sıradaki hatırlatıcı -->
        <Grid x:Name="Layout_calendar" Width="186">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="CalendarWeekday" HorizontalAlignment="Center" FontSize="9" FontWeight="Bold"
                           Foreground="{DynamicResource AccentRedBrush}" FontFamily="{StaticResource UiFont}" />
                <TextBlock x:Name="CalendarDay" Style="{StaticResource ValueText}" FontSize="19" LineHeight="21" HorizontalAlignment="Center" />
            </StackPanel>
            <Border Grid.Column="1" Width="1" Margin="8,9" Background="{DynamicResource SeparatorBrush}" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <DockPanel>
                    <Ellipse x:Name="EventDot" DockPanel.Dock="Left" Width="6" Height="6" Margin="0,1,5,0"
                             Fill="{DynamicResource AccentOrangeBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="EventTitle" Style="{StaticResource TitleText}" />
                </DockPanel>
                <TextBlock x:Name="EventTime" Style="{StaticResource CaptionText}" />
            </StackPanel>
        </Grid>

        <!-- Saat Popup'ı (Görsel 1 tasarımı) -->
        <Popup x:Name="ClockPopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None" Placement="Top">
            <Border CornerRadius="16" Padding="20,14" BorderThickness="1" Margin="8" Width="260"
                    Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupBorderBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Direction="270" />
                </Border.Effect>
                <StackPanel>
                    <!-- Başlık ve Kapat Butonu -->
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Clock" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource UiFont}"
                                   VerticalAlignment="Center" />
                        <Button Style="{StaticResource CardIconButton}" Width="24" Height="24"
                                HorizontalAlignment="Right" Click="OnPopupCloseClick" Cursor="Hand">
                            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Button>
                    </Grid>

                    <!-- Büyük Canlı Dijital Saat -->
                    <TextBlock x:Name="PopupClockTime" Text="18:26:48" FontSize="38" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="{StaticResource UiFont}" Margin="0,6,0,6" />

                    <!-- Tarih -->
                    <TextBlock x:Name="PopupClockDate" Text="Friday, September 18" FontSize="13.5"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="{StaticResource UiFont}" Margin="0,0,0,6" />

                    <!-- Konum / Saat Dilimi -->
                    <TextBlock x:Name="PopupClockZone" Text="Istanbul · GMT+03:00" FontSize="12"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontFamily="{StaticResource UiFont}" Margin="0,0,0,4" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</w:WidgetBase>
