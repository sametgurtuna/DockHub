<w:WidgetBase x:Class="CustomDock.Widgets.HydrationWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:CustomDock.Widgets"
              xmlns:ctl="clr-namespace:CustomDock.Controls"
              Cursor="Hand">
    <Grid Background="Transparent" MouseLeftButtonUp="OnClick">
        <!-- Timer: blue card, countdown to next reminder -->
        <StackPanel x:Name="Layout_timer" MinWidth="96" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <ScaleTransform x:Name="TimerScale" />
            </StackPanel.RenderTransform>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Data="M12,2 C12,2 5,10 5,15 A7,7 0 0 0 19,15 C19,10 12,2 12,2 Z"
                      Stretch="Uniform" Width="11" Height="14"
                      Fill="{DynamicResource TextOnColorBrush}" Margin="0,1,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="TimerText" Style="{StaticResource ValueText}" FontSize="19" LineHeight="22"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextOnColorBrush}" />
            </StackPanel>
            <TextBlock x:Name="TimerCaption" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"
                       Foreground="#D9FFFFFF" />
        </StackPanel>

        <!-- Daily goal ring -->
        <StackPanel x:Name="Layout_progress" Orientation="Horizontal" MinWidth="104">
            <Grid Width="32" Height="32" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="RingScale" />
                </Grid.RenderTransform>
                <ctl:RingGauge x:Name="Ring" Thickness="4" Maximum="8"
                               Fill="{DynamicResource AccentCyanBrush}" Track="{DynamicResource TrackBrush}" />
                <Path Data="M12,2 C12,2 5,10 5,15 A7,7 0 0 0 19,15 C19,10 12,2 12,2 Z" Stretch="Uniform" Width="9" Height="12"
                      Fill="{DynamicResource AccentCyanBrush}" Margin="0,1,0,0" />
            </Grid>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource ValueText}"><Run x:Name="CountRun" Text="0" /><Run x:Name="GoalRun" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="/8" /></TextBlock>
                <TextBlock x:Name="ProgressCaption" Style="{StaticResource CaptionText}" Text="glasses" />
            </StackPanel>
        </StackPanel>
    </Grid>
</w:WidgetBase>
