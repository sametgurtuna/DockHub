<w:WidgetBase x:Class="CustomDock.Widgets.MediaWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:CustomDock.Widgets"
              xmlns:ctl="clr-namespace:CustomDock.Controls">
    <w:WidgetBase.Resources>
        <Style x:Key="MediaButton" TargetType="Button" BasedOn="{StaticResource CardIconButton}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </w:WidgetBase.Resources>
    <Grid Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OnWidgetMouseLeftButtonUp">
        <!-- Full -->
        <Grid x:Name="Layout_full" Width="252">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="FullArt" Grid.RowSpan="2" Width="36" Height="36" CornerRadius="6" VerticalAlignment="Center"
                    Background="{DynamicResource SubtleFillBrush}">
                <TextBlock x:Name="FullArtGlyph" Text="&#xE8D6;" Style="{StaticResource IconText}" FontSize="15"
                           Foreground="{DynamicResource AccentPinkBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Bottom">
                <TextBlock x:Name="FullTitle" Style="{StaticResource TitleText}" FontSize="12.5" />
                <TextBlock x:Name="FullArtist" Style="{StaticResource CaptionText}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="FullPrev" Style="{StaticResource MediaButton}" Content="&#xE892;" Click="OnPreviousClick" />
                <Button x:Name="FullPlay" Style="{StaticResource MediaButton}" Content="&#xE768;" FontSize="13" Click="OnPlayPauseClick" />
                <Button x:Name="FullNext" Style="{StaticResource MediaButton}" Content="&#xE893;" Click="OnNextClick" />
            </StackPanel>
            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,2,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FullPosition" Style="{StaticResource MicroText}" Text="0:00" Typography.NumeralAlignment="Tabular" />
                <Grid x:Name="FullTrack" Grid.Column="1" Height="3" Margin="7,0">
                    <Border CornerRadius="1.5" Background="{DynamicResource TrackBrush}" />
                    <Border x:Name="FullFill" CornerRadius="1.5" HorizontalAlignment="Left" Width="0" Background="{DynamicResource TextSecondaryBrush}" />
                </Grid>
                <TextBlock x:Name="FullDuration" Grid.Column="2" Style="{StaticResource MicroText}" Text="0:00" Typography.NumeralAlignment="Tabular" />
            </Grid>
        </Grid>

        <!-- Compact -->
        <Grid x:Name="Layout_compact" Width="196">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="CompactArt" Width="32" Height="32" CornerRadius="6" Background="{DynamicResource SubtleFillBrush}">
                <TextBlock x:Name="CompactArtGlyph" Text="&#xE8D6;" Style="{StaticResource IconText}" FontSize="14"
                           Foreground="{DynamicResource AccentPinkBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="9,0,4,0" VerticalAlignment="Center">
                <TextBlock x:Name="CompactTitle" Style="{StaticResource TitleText}" FontSize="12.5" />
                <TextBlock x:Name="CompactArtist" Style="{StaticResource CaptionText}" />
            </StackPanel>
            <Button x:Name="CompactPlay" Grid.Column="2" Style="{StaticResource MediaButton}" Width="30" Height="30" FontSize="14"
                    Content="&#xE768;" Click="OnPlayPauseClick" />
        </Grid>

        <!-- Mini -->
        <Button x:Name="Layout_mini" Style="{StaticResource MediaButton}" Width="30" Height="30" FontSize="16"
                Content="&#xE768;" Click="OnPlayPauseClick" />

        <!-- Media Player Popup -->
        <Popup x:Name="MediaPopup" StaysOpen="True" AllowsTransparency="True" PopupAnimation="None" Placement="Top">
            <ctl:WidgetFlyout Title="Now Playing" Icon="&#xE8D6;" Size="Narrow" ShowCloseButton="True" Padding="16,12">
                <ctl:WidgetFlyout.HeaderActions>
                    <Button Style="{StaticResource CardIconButton}" Width="24" Height="24" Cursor="Hand" ToolTip="Audio Settings"
                            Content="&#xE9E9;" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Click="OnPopupMixerClick" />
                </ctl:WidgetFlyout.HeaderActions>
                <StackPanel>
                    <!-- Album art image -->
                    <Border x:Name="PopupArtBorder" Width="148" Height="148" CornerRadius="12"
                            Background="{DynamicResource SubtleFillBrush}" HorizontalAlignment="Center"
                            Margin="0,8,0,10" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="PopupArtGlyph" Text="&#xE8D6;" Style="{StaticResource IconText}"
                                       FontSize="42" Foreground="{DynamicResource AccentPinkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="PopupArtImage" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <!-- Track title and artist -->
                    <TextBlock x:Name="PopupTitle" Text="Nothing playing" FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource UiFont}"
                               TextTrimming="CharacterEllipsis" Margin="4,0,4,2" />
                    <TextBlock x:Name="PopupArtist" Text="Start a media player" FontSize="12.5"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource UiFont}"
                               TextTrimming="CharacterEllipsis" Margin="4,0,4,10" />

                    <!-- Progress bar and duration -->
                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PopupPosition" Style="{StaticResource MicroText}" Text="0:00"
                                   VerticalAlignment="Center" Margin="0,0,6,0" Typography.NumeralAlignment="Tabular" />
                        <Slider x:Name="PopupSeekSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                Height="18" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                PreviewMouseDown="OnSeekSliderMouseDown" PreviewMouseUp="OnSeekSliderMouseUp" />
                        <TextBlock x:Name="PopupDuration" Grid.Column="2" Style="{StaticResource MicroText}" Text="0:00"
                                   VerticalAlignment="Center" Margin="6,0,0,0" Typography.NumeralAlignment="Tabular" />
                    </Grid>

                    <!-- Playback controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,8">
                        <Button x:Name="PopupPrev" Style="{StaticResource MediaButton}" Width="34" Height="34"
                                Content="&#xE892;" FontSize="14" Margin="0,0,14,0" Click="OnPreviousClick" />
                        <Button x:Name="PopupPlay" Style="{StaticResource MediaButton}" Width="42" Height="42"
                                Content="&#xE768;" FontSize="17" Click="OnPlayPauseClick" />
                        <Button x:Name="PopupNext" Style="{StaticResource MediaButton}" Width="34" Height="34"
                                Content="&#xE893;" FontSize="14" Margin="14,0,0,0" Click="OnNextClick" />
                    </StackPanel>

                    <!-- Volume bar -->
                    <Grid Margin="6,2,6,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE74F;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Slider x:Name="PopupVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                Height="18" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                ValueChanged="OnPopupVolumeChanged" />
                        <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>

                    <!-- Footer / source -->
                    <TextBlock x:Name="PopupFooter" Text="" FontSize="11"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource UiFont}"
                               TextTrimming="CharacterEllipsis" Margin="4,8,4,0" />
                </StackPanel>
            </ctl:WidgetFlyout>
        </Popup>
    </Grid>
</w:WidgetBase>
