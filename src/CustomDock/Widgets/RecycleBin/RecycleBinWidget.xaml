<w:WidgetBase x:Class="CustomDock.Widgets.RecycleBinWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:CustomDock.Widgets"
              Cursor="Hand"
              AllowDrop="True"
              Background="Transparent">
    <Grid Background="Transparent">
        <!-- Icon View -->
        <Border x:Name="Layout_icon" Width="36" Height="36" CornerRadius="18"
                Background="{DynamicResource SurfaceLightBrush}" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Path x:Name="IconOnlyPath" Width="17" Height="17" Stretch="Uniform"
                  Fill="{DynamicResource AccentBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- Detailed View (Icon + Title + Item count and size) -->
        <StackPanel x:Name="Layout_details" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource SurfaceLightBrush}" Margin="0,0,8,0">
                <Path x:Name="DetailsIconPath" Width="14" Height="14" Stretch="Uniform"
                      Fill="{DynamicResource AccentBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" MaxWidth="110">
                <TextBlock Text="Recycle Bin" Style="{StaticResource TitleText}" FontSize="12" />
                <TextBlock x:Name="DetailsSubText" Style="{StaticResource CaptionText}" Text="Empty" />
            </StackPanel>
        </StackPanel>
    </Grid>
</w:WidgetBase>
