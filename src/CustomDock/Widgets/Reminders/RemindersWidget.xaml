<w:WidgetBase x:Class="CustomDock.Widgets.RemindersWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:CustomDock.Widgets"
              Cursor="Hand">
    <w:WidgetBase.Resources>
        <!-- Blue circular list icon + count -->
        <DataTemplate x:Key="CountBlock">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Grid Width="20" Height="20" VerticalAlignment="Center">
                        <Ellipse Fill="{DynamicResource AccentBlueBrush}" />
                        <Path Data="M8,6 H20 M8,12 H20 M8,18 H20 M3.5,6 H4 M3.5,12 H4 M3.5,18 H4" Stretch="Uniform" Width="10" Height="8"
                              Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                    <TextBlock Text="{Binding Count}" Style="{StaticResource ValueText}" FontSize="19" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Reminders" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
        </DataTemplate>
    </w:WidgetBase.Resources>

    <Grid>
        <Grid Background="Transparent" MouseLeftButtonUp="OnBodyClick">
            <!-- List -->
            <Grid x:Name="Layout_list" Width="226">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl x:Name="ListCount" ContentTemplate="{StaticResource CountBlock}" Focusable="False" />
                <ItemsControl x:Name="ListItems" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" FontSize="11.5" LineHeight="13.5" LineStackingStrategy="BlockLineHeight"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="ListEmpty" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource CaptionText}" Text="Click to add" />
            </Grid>

            <!-- Next -->
            <Grid x:Name="Layout_next" Width="196">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl x:Name="NextCount" ContentTemplate="{StaticResource CountBlock}" Focusable="False" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="NextText" Style="{StaticResource TitleText}" FontSize="13" LineHeight="15"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30" />
                    <TextBlock x:Name="NextTime" Style="{StaticResource CaptionText}" />
                </StackPanel>
            </Grid>

            <!-- Count -->
            <ContentControl x:Name="Layout_count" MinWidth="80" ContentTemplate="{StaticResource CountBlock}" Focusable="False" />
        </Grid>

        <!-- Add / list popup -->
        <Popup x:Name="EditorPopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Opened="OnPopupOpened">
            <Border Width="320" Margin="10" Padding="16" CornerRadius="12"
                    Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1"
                    TextElement.Foreground="{DynamicResource TextPrimaryBrush}" TextElement.FontFamily="{StaticResource UiFont}">
                <StackPanel>
                    <TextBlock Text="New reminder" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" />
                    <TextBox x:Name="NewText" Tag="What to remind?" Margin="0,10,0,0" KeyDown="OnEditorKeyDown" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="DayCombo" DisplayMemberPath="Label" />
                        <TextBox x:Name="TimeBox" Grid.Column="2" Tag="HH:mm" HorizontalContentAlignment="Center"
                                 KeyDown="OnEditorKeyDown" MaxLength="5" />
                    </Grid>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource PillButton}" Content="+5m" Tag="5" Margin="0,0,6,0" Click="OnQuickClick" />
                        <Button Style="{StaticResource PillButton}" Content="+15m" Tag="15" Margin="0,0,6,0" Click="OnQuickClick" />
                        <Button Style="{StaticResource PillButton}" Content="+30m" Tag="30" Margin="0,0,6,0" Click="OnQuickClick" />
                        <Button Style="{StaticResource PillButton}" Content="+1h" Tag="60" Margin="0,0,6,0" Click="OnQuickClick" />
                        <Button Style="{StaticResource PillButton}" Content="+3h" Tag="180" Click="OnQuickClick" />
                    </WrapPanel>
                    <Grid Margin="0,12,0,0">
                        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,80,0" />
                        <Button Style="{StaticResource AccentButton}" Content="Add" HorizontalAlignment="Right" MinWidth="72" Click="OnAddClick" />
                    </Grid>

                    <Border Height="1" Margin="0,14,0,10" Background="{DynamicResource SeparatorBrush}" />
                    <TextBlock Text="Pending" FontWeight="SemiBold" FontSize="12.5" />
                    <TextBlock x:Name="EmptyText" Text="No pending reminders." Margin="0,6,0,0" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ScrollViewer MaxHeight="210" Margin="0,4,-8,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PendingList" Margin="0,0,8,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" FontSize="12.5" />
                                            <TextBlock Text="{Binding Due, StringFormat={}{0:ddd d MMM · HH:mm}}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="11"
                                                Width="26" Height="26" ToolTip="Delete" Click="OnDeleteClick" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</w:WidgetBase>
