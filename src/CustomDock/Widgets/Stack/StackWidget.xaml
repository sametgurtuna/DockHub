<w:WidgetBase x:Class="CustomDock.Widgets.StackWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:CustomDock.Widgets"
              Cursor="Hand"
              Background="Transparent">
    <Grid Background="Transparent">
        <!-- Stacked file icons -->
        <Grid x:Name="Layout_stack" Width="40" Height="40">
            <Image x:Name="Icon3" Width="26" Height="26" Margin="12,0,0,10" Opacity="0.55" RenderOptions.BitmapScalingMode="HighQuality" />
            <Image x:Name="Icon2" Width="28" Height="28" Margin="6,4,0,4" Opacity="0.8" RenderOptions.BitmapScalingMode="HighQuality" />
            <Image x:Name="Icon1" Width="30" Height="30" Margin="0,10,6,0" RenderOptions.BitmapScalingMode="HighQuality" />
        </Grid>

        <!-- Folder name and newest file -->
        <StackPanel x:Name="Layout_details" Orientation="Horizontal" VerticalAlignment="Center">
            <Image x:Name="DetailsIcon" Width="28" Height="28" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center" Width="130">
                <TextBlock x:Name="FolderTitle" Style="{StaticResource TitleText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="NewestText" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>

        <Popup x:Name="FilesPopup" StaysOpen="True" AllowsTransparency="True" PopupAnimation="None" Placement="Top">
            <Border CornerRadius="14" Padding="10" BorderThickness="1" Margin="8" Width="392"
                    Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupBorderBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Direction="270" />
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8">
                        <Button DockPanel.Dock="Right" Content="Open folder" Click="OnOpenFolderClick" Padding="10,2" />
                        <TextBlock x:Name="PopupTitle" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="FileGrid" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</w:WidgetBase>
