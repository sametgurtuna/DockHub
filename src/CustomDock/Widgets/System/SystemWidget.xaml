<w:WidgetBase x:Class="CustomDock.Widgets.SystemWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:CustomDock.Widgets"
              xmlns:ctl="clr-namespace:CustomDock.Controls">
    <Grid Background="Transparent">
        <!-- Sayılar -->
        <StackPanel x:Name="Layout_numbers" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel MinWidth="56">
                <TextBlock x:Name="CpuNumber" Style="{StaticResource ValueText}" FontSize="19" LineHeight="22" />
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentMagentaBrush}" VerticalAlignment="Center" Margin="0,1,5,0" />
                    <TextBlock Text="CPU" Style="{StaticResource CaptionText}" />
                </StackPanel>
            </StackPanel>
            <StackPanel MinWidth="56" Margin="18,0,0,0">
                <TextBlock x:Name="RamNumber" Style="{StaticResource ValueText}" FontSize="19" LineHeight="22" />
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBlueBrush}" VerticalAlignment="Center" Margin="0,1,5,0" />
                    <TextBlock Text="Bellek" Style="{StaticResource CaptionText}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Halkalar -->
        <StackPanel x:Name="Layout_rings" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel Width="46">
                <Grid Width="28" Height="28">
                    <ctl:RingGauge x:Name="CpuRing" Thickness="3.5" Fill="{DynamicResource AccentMagentaBrush}" Track="{DynamicResource MagentaTrackBrush}" />
                    <TextBlock x:Name="CpuRingText" FontSize="8.5" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="CPU" Style="{StaticResource MicroText}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,1,0,0" />
            </StackPanel>
            <StackPanel Width="46" Margin="10,0,0,0">
                <Grid Width="28" Height="28">
                    <ctl:RingGauge x:Name="RamRing" Thickness="3.5" Fill="{DynamicResource AccentBlueBrush}" Track="{DynamicResource BlueTrackBrush}" />
                    <TextBlock x:Name="RamRingText" FontSize="8.5" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Bellek" Style="{StaticResource MicroText}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,1,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Çubuklar -->
        <Grid x:Name="Layout_bars" Width="172" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="38" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="19" />
                <RowDefinition Height="19" />
            </Grid.RowDefinitions>
            <TextBlock Text="CPU" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            <Grid x:Name="CpuBarTrack" Grid.Column="1" Height="5" VerticalAlignment="Center">
                <Border CornerRadius="2.5" Background="{DynamicResource MagentaTrackBrush}" />
                <Border x:Name="CpuBar" CornerRadius="2.5" HorizontalAlignment="Left" Width="0" Background="{DynamicResource AccentMagentaBrush}" />
            </Grid>
            <TextBlock x:Name="CpuBarText" Grid.Column="2" Style="{StaticResource TitleText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="Bellek" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            <Grid x:Name="RamBarTrack" Grid.Row="1" Grid.Column="1" Height="5" VerticalAlignment="Center">
                <Border CornerRadius="2.5" Background="{DynamicResource BlueTrackBrush}" />
                <Border x:Name="RamBar" CornerRadius="2.5" HorizontalAlignment="Left" Width="0" Background="{DynamicResource AccentBlueBrush}" />
            </Grid>
            <TextBlock x:Name="RamBarText" Grid.Row="1" Grid.Column="2" Style="{StaticResource TitleText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</w:WidgetBase>
