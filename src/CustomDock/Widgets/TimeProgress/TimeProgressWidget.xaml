<w:WidgetBase x:Class="CustomDock.Widgets.TimeProgressWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:CustomDock.Widgets"
              xmlns:ctl="clr-namespace:CustomDock.Controls">
    <Grid Background="Transparent">
        <!-- Barkod -->
        <StackPanel x:Name="Layout_bar" Width="168" VerticalAlignment="Center">
            <DockPanel>
                <TextBlock x:Name="BarPercent" DockPanel.Dock="Right" Style="{StaticResource ValueText}" FontSize="15" LineHeight="18" />
                <TextBlock x:Name="BarTitle" Style="{StaticResource TitleText}" VerticalAlignment="Bottom" Margin="0,0,0,1" />
            </DockPanel>
            <ctl:TickBar x:Name="Ticks" Height="14" Margin="0,4,0,0" TickWidth="2" Gap="2"
                         OnBrush="{DynamicResource TickOnBrush}" OffBrush="{DynamicResource TickOffBrush}" />
        </StackPanel>

        <!-- Halka -->
        <StackPanel x:Name="Layout_ring" Orientation="Horizontal" MinWidth="128">
            <Grid Width="32" Height="32" VerticalAlignment="Center">
                <ctl:RingGauge x:Name="Ring" Thickness="4" Maximum="1"
                               Fill="{DynamicResource AccentPurpleBrush}" Track="{DynamicResource TrackBrush}" />
                <TextBlock x:Name="RingPercent" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource DisplayFont}" />
            </Grid>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="RingTitle" Style="{StaticResource TitleText}" FontSize="14" LineHeight="17" />
                <TextBlock x:Name="RingDetail" Style="{StaticResource CaptionText}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</w:WidgetBase>
