<w:WidgetBase x:Class="CustomDock.Widgets.AlarmWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:CustomDock.Widgets"
              xmlns:ctl="clr-namespace:CustomDock.Controls"
              Cursor="Hand">
    <Grid>
        <Grid Width="140" Background="Transparent" MouseLeftButtonUp="OnClick">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource ValueText}" FontWeight="Normal" FontSize="17" Text="Alarm" />
                <TextBlock x:Name="SubText" Style="{StaticResource CaptionText}" Text="Set time" />
            </StackPanel>
            <Path x:Name="Bell" Grid.Column="1" VerticalAlignment="Top" Margin="0,7,0,0" Width="17" Height="17" Stretch="Uniform"
                  Data="M12,6 A7,7 0 1 1 11.99,6 Z M12,9 V13 L14,14 M4,5 L7,2.5 M20,5 L17,2.5"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Grid>

        <Popup x:Name="EditorPopup" StaysOpen="True" AllowsTransparency="True" PopupAnimation="None" Opened="OnPopupOpened">
            <Border Width="270" Margin="10" Padding="16" CornerRadius="12"
                    Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1"
                    TextElement.Foreground="{DynamicResource TextPrimaryBrush}" TextElement.FontFamily="{StaticResource UiFont}">
                <StackPanel>
                    <TextBlock Text="Alarm" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TimeBox" Tag="HH:mm" MaxLength="5" HorizontalContentAlignment="Center" FontSize="16" KeyDown="OnEditorKeyDown" />
                        <TextBox x:Name="LabelBox" Grid.Column="2" Tag="Label" KeyDown="OnEditorKeyDown" />
                    </Grid>
                    <CheckBox x:Name="RepeatBox" Content="Repeat daily" Margin="0,12,0,0" />
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button x:Name="DisableButton" Content="Turn off" Margin="0,0,8,0" Click="OnDisableClick" />
                        <Button Style="{StaticResource AccentButton}" Content="Set" MinWidth="72" Click="OnSaveClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</w:WidgetBase>
