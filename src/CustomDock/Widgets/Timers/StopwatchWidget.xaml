<w:WidgetBase x:Class="CustomDock.Widgets.StopwatchWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:CustomDock.Widgets"
              Cursor="Hand">
    <StackPanel MinWidth="92" VerticalAlignment="Center" Background="Transparent" MouseLeftButtonUp="OnClick">
        <TextBlock x:Name="TimeText" Style="{StaticResource ValueText}" FontSize="19" LineHeight="22" HorizontalAlignment="Center" Text="0:00" />
        <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Text="Ready" />
    </StackPanel>
</w:WidgetBase>
