<w:WidgetBase x:Class="CustomDock.Widgets.WorldClockWidget"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:w="clr-namespace:CustomDock.Widgets"
              xmlns:ctl="clr-namespace:CustomDock.Controls">
    <Grid Background="Transparent">
        <!-- Tek şehir -->
        <StackPanel x:Name="Layout_single" Orientation="Horizontal" MinWidth="118">
            <ctl:AnalogClock x:Name="SingleClock" Width="30" Height="30" VerticalAlignment="Center"
                             Accent="{DynamicResource AccentOrangeBrush}"
                             DayFace="{DynamicResource ClockFaceDayBrush}" NightFace="{DynamicResource ClockFaceNightBrush}" />
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="SingleTime" Style="{StaticResource ValueText}" />
                <TextBlock x:Name="SingleCity" Style="{StaticResource CaptionText}" MaxWidth="110" />
            </StackPanel>
        </StackPanel>

        <!-- Çoklu şehir -->
        <ItemsControl x:Name="Layout_multi" Focusable="False" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" ToolTip="{Binding Details}" Background="Transparent">
                        <ctl:AnalogClock Width="22" Height="22" VerticalAlignment="Center" Time="{Binding Time}"
                                         Accent="{DynamicResource AccentOrangeBrush}"
                                         DayFace="{DynamicResource ClockFaceDayBrush}" NightFace="{DynamicResource ClockFaceNightBrush}" />
                        <StackPanel Margin="7,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource TitleText}" FontSize="13.5" Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="{Binding Label}" Style="{StaticResource MicroText}" MaxWidth="70" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</w:WidgetBase>
