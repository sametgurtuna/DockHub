---
import Bloom from './Bloom.astro';
import { icons, dockLogo } from '../lib/icons';
import { site } from '../lib/site';
---

<section class="section cta-section" id="indir">
  <div class="wrap">
    <div class="cta reveal">
      <Bloom id="bloom-cta" class="cta-bloom" />
      <div class="cta-inner">
        <span class="cta-logo" set:html={dockLogo('dl-cta')} />
        <h2 class="cta-title">Masaüstünü evin yap.</h2>
        <p class="cta-lead">Ücretsiz, açık kaynak ve yönetici izni istemez. Beğenmezsen tek tıkla eski görev çubuğuna dönersin.</p>
        <div class="cta-actions">
          <a class="btn btn-primary" href={site.downloadUrl}>
            <span set:html={icons.windows} />
            Ücretsiz indir
          </a>
          <a class="btn btn-glass" href={site.githubUrl}>
            <span set:html={icons.github} />
            Kaynak kodu
          </a>
        </div>
        <p class="cta-fine">Windows 10 1809 ve üstü · .NET 8 Desktop Runtime gerekir</p>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 32px;
    min-height: clamp(460px, 48vw, 620px);
    display: grid;
    place-items: center;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.1),
      0 60px 140px -60px rgb(24 104 255 / 0.7);
  }
  .cta :global(.cta-bloom) {
    z-index: -1;
  }
  .cta :global(.cta-bloom .bloom-breathe) {
    transform-origin: 50% 90%;
  }
  .cta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(60% 55% at 50% 42%, rgb(2 6 18 / 0.72), rgb(2 6 18 / 0.1) 70%);
  }
  .cta-inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 18px;
    padding: clamp(48px, 7vw, 80px) 24px;
  }
  .cta-logo {
    width: 76px;
    height: 76px;
    filter: drop-shadow(0 16px 30px rgb(0 0 0 / 0.6));
  }
  .cta-title {
    font-size: clamp(2.5rem, 6.4vw, 5.25rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.04em;
    max-width: 12ch;
    text-shadow: 0 4px 40px rgb(0 10 40 / 0.6);
  }
  .cta-lead {
    max-width: 42ch;
    font-size: clamp(1.0625rem, 1.7vw, 1.25rem);
    color: rgb(230 238 255 / 0.86);
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }
  .cta-actions .btn {
    --btn-h: 54px;
    padding-inline: 26px;
    font-size: 1.0625rem;
  }
  .cta-actions .btn span {
    width: 18px;
    height: 18px;
    display: grid;
  }
  .btn-glass {
    color: #fff;
    background: rgb(255 255 255 / 0.12);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.22);
  }
  .btn-glass:hover {
    background: rgb(255 255 255 / 0.2);
  }
  .cta-fine {
    font-size: 0.875rem;
    color: rgb(214 226 250 / 0.72);
  }
</style>
