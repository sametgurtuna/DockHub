---
import Bloom from './Bloom.astro';
import { icons, windowsLogo, dockLogo } from '../lib/icons';
import { appIcons } from '../lib/apps';

const tbApps = ['explorer', 'browser', 'terminal', 'notepad'] as const;
---

<div class="stage-shell" data-stage-shell>
  <div
    class="stage"
    data-stage
    data-theme="dark"
    data-edge="bottom"
    data-layout="floating"
    data-size="small"
    data-mode="replace"
    data-backdrop="blur"
    data-phase="boot"
    role="application"
    aria-roledescription="Custom Dock canlı demosu"
    aria-label="Windows 11 masaüstünde çalışan Custom Dock demosu"
  >
    <Bloom id="bloom-stage" />

    <div class="desk-icons" data-desk-icons>
      <button class="desk-icon" data-open="pc" type="button">
        <span class="desk-icon-img" set:html={appIcons.pc} />
        <span>Bu bilgisayar</span>
      </button>
      <button class="desk-icon" data-open="bin" type="button">
        <span class="desk-icon-img" set:html={appIcons.bin} />
        <span>Geri Dönüşüm Kutusu</span>
      </button>
      <button class="desk-icon" data-open="dock-settings" type="button">
        <span class="desk-icon-img" set:html={dockLogo('dl-desk')} />
        <span>Custom Dock</span>
      </button>
    </div>

    <div class="windows-layer" data-windows></div>

    <div class="win-taskbar" data-win-taskbar aria-hidden="true">
      <div class="wtb-left">
        <span class="wtb-weather"><span class="wtb-sun"></span><span><b>18°C</b><small>Parçalı bulutlu</small></span></span>
      </div>
      <div class="wtb-center">
        <span class="wtb-btn wtb-start" set:html={windowsLogo('wl-tb')} />
        <span class="wtb-btn wtb-search"><span set:html={icons.search} /><span>Ara</span></span>
        <span class="wtb-btn" set:html={icons.taskView} />
        {tbApps.map((a) => <span class="wtb-btn wtb-app" set:html={appIcons[a]} />)}
      </div>
      <div class="wtb-right">
        <span class="wtb-ic" set:html={icons.chevronUp} />
        <span class="wtb-ic" set:html={icons.wifi} />
        <span class="wtb-ic" set:html={icons.volume} />
        <span class="wtb-ic" set:html={icons.battery} />
        <span class="wtb-clock" data-clock-tb><span>--:--</span><span>--.--.----</span></span>
      </div>
    </div>

    <nav class="dock" data-dock aria-label="Custom Dock">
      <div class="dock-zone dock-start">
        <button class="db db-start" type="button" data-start aria-label="Başlat" set:html={windowsLogo('wl-dock')} />
        <button class="db db-icon" type="button" data-search aria-label="Ara" set:html={icons.search} />
      </div>
      <div class="dock-center">
        <button class="dock-arrow dock-arrow-prev" type="button" tabindex="-1" aria-label="Geri kaydır" data-scroll="-1" set:html={icons.chevronLeft} />
        <div class="dock-scroll" data-dock-scroll>
          <div class="dock-items" data-dock-items></div>
        </div>
        <button class="dock-arrow dock-arrow-next" type="button" tabindex="-1" aria-label="İleri kaydır" data-scroll="1" set:html={icons.chevronRight} />
      </div>
      <div class="dock-zone dock-end">
        <div class="dock-tray" data-tray>
          <button class="db db-tray" type="button" data-tray-more aria-label="Gizli simgeleri göster" set:html={icons.chevronUp} />
          <button class="db db-tray" type="button" data-quick aria-label="Ağ, ses ve pil" >
            <span set:html={icons.wifi} /><span set:html={icons.volume} /><span set:html={icons.battery} />
          </button>
        </div>
        <button class="db db-clock" type="button" data-clock aria-label="Saat ve bildirimler">
          <span data-clock-time>--:--</span>
          <span data-clock-date>--.--.----</span>
        </button>
        <button class="db-desktop" type="button" data-show-desktop aria-label="Masaüstünü göster"></button>
      </div>
    </nav>

    <div class="edge-hint" data-edge-hint>Dock'u geri getirmek için imleci kenara götür</div>
    <div class="layer" data-layer></div>
    <div class="toasts" data-toasts aria-live="polite"></div>
  </div>
</div>

<slot name="between" />

<div class="demo-bar" data-demo-bar>
  <div class="seg-group">
    <span class="seg-label" id="lbl-mode">Mod</span>
    <div class="seg" role="radiogroup" aria-labelledby="lbl-mode" data-control="mode">
      <button type="button" role="radio" data-value="replace">Yerini al</button>
      <button type="button" role="radio" data-value="both">İkisi birlikte</button>
    </div>
  </div>
  <div class="seg-group">
    <span class="seg-label" id="lbl-edge">Konum</span>
    <div class="seg" role="radiogroup" aria-labelledby="lbl-edge" data-control="edge">
      <button type="button" role="radio" data-value="bottom">Alt</button>
      <button type="button" role="radio" data-value="left">Sol</button>
      <button type="button" role="radio" data-value="right">Sağ</button>
      <button type="button" role="radio" data-value="top">Üst</button>
    </div>
  </div>
  <div class="seg-group">
    <span class="seg-label" id="lbl-layout">Biçim</span>
    <div class="seg" role="radiogroup" aria-labelledby="lbl-layout" data-control="layout">
      <button type="button" role="radio" data-value="floating">Yüzen</button>
      <button type="button" role="radio" data-value="attached">Yapışık</button>
    </div>
  </div>
  <div class="seg-group">
    <span class="seg-label" id="lbl-theme">Tema</span>
    <div class="seg" role="radiogroup" aria-labelledby="lbl-theme" data-control="theme">
      <button type="button" role="radio" data-value="dark">Koyu</button>
      <button type="button" role="radio" data-value="light">Açık</button>
    </div>
  </div>
  <div class="demo-bar-actions">
    <button class="bar-btn bar-btn-accent" type="button" data-add-widget>
      <span set:html={icons.widgets} />Widget ekle
    </button>
    <button class="bar-btn" type="button" data-open-settings>
      <span set:html={icons.settings} />Tüm ayarlar
    </button>
  </div>
</div>

<script>
  import { initDemo } from '../scripts/demo';
  initDemo();
</script>
