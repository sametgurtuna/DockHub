---
import { dockLogo } from '../lib/icons';
import { site } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap foot">
    <div class="foot-brand">
      <a class="brand" href="#top">
        <span class="brand-mark" set:html={dockLogo('dl-foot')} />
        <span>Custom Dock</span>
      </a>
      <p>Windows için widget'lı, cam gibi bir dock. .NET 8 ve WPF ile yazıldı.</p>
    </div>
    <nav class="foot-cols" aria-label="Alt bağlantılar">
      <div>
        <h3>Ürün</h3>
        <a href="#demo">Canlı demo</a>
        <a href="#widgetlar">Widget'lar</a>
        <a href="#ozellikler">Özellikler</a>
        <a href={site.downloadUrl}>İndir</a>
      </div>
      <div>
        <h3>Proje</h3>
        <a href={site.githubUrl}>GitHub</a>
        <a href={site.readmeUrl}>Belgeler</a>
        <a href={site.licenseUrl}>Lisans</a>
        <a href="#sss">SSS</a>
      </div>
      <div>
        <h3>Teşekkürler</h3>
        <a href="https://github.com/cairoshell/ManagedShell" rel="noopener">ManagedShell</a>
        <a href="https://github.com/dremin/RetroBar" rel="noopener">RetroBar</a>
        <a href="https://open-meteo.com/" rel="noopener">Open-Meteo</a>
      </div>
    </nav>
  </div>
  <div class="wrap foot-legal">
    <p>© {year} Custom Dock. Hava durumu verisi Open-Meteo (CC BY 4.0).</p>
    <p>Windows, Microsoft Corporation'ın ticari markasıdır. Custom Dock, Microsoft ile bağlantılı değildir.</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(72px, 9vw, 120px);
    padding: 56px 0 40px;
    border-top: 1px solid var(--line);
    background: var(--bg-sunk);
  }
  .foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 40px;
  }
  .foot-brand {
    display: grid;
    align-content: start;
    gap: 14px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    justify-self: start;
  }
  .brand-mark {
    width: 34px;
    height: 34px;
  }
  .foot-brand p {
    color: var(--text-3);
    max-width: 34ch;
    font-size: 0.9375rem;
  }
  .foot-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .foot-cols div {
    display: grid;
    align-content: start;
    gap: 10px;
  }
  .foot-cols h3 {
    font-size: 0.875rem;
    color: var(--text);
    margin-bottom: 4px;
  }
  .foot-cols a {
    color: var(--text-3);
    font-size: 0.9375rem;
    text-decoration: none;
    justify-self: start;
    transition: color var(--t-fast);
  }
  .foot-cols a:hover {
    color: var(--text);
  }
  .foot-legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    color: var(--text-3);
  }
  @media (max-width: 760px) {
    .foot {
      grid-template-columns: 1fr;
    }
    .foot-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
