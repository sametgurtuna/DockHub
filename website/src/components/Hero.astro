---
import Desktop from './Desktop.astro';
import { icons } from '../lib/icons';
import { site } from '../lib/site';
---

<section class="hero" id="top">
  <div class="wrap hero-copy">
    <h1 class="hero-title">
      <span class="line"><span>Görev çubuğun.</span></span>
      <span class="line"><span>Yeniden tasarlandı.</span></span>
    </h1>
    <p class="hero-lead">
      Windows görev çubuğunun yerine widget'lı, cam gibi bir dock koy. Başlat, tepsi ve açık uygulamaların yerinde kalır.
    </p>
    <div class="hero-cta">
      <a class="btn btn-primary" href={site.downloadUrl}>
        <span set:html={icons.windows} />
        Ücretsiz indir
      </a>
      <a class="btn btn-quiet" href={site.githubUrl}>
        <span set:html={icons.github} />
        GitHub'da incele
      </a>
    </div>
    <p class="fine hero-fine">Ücretsiz ve açık kaynak · Windows 10 ve 11 · Yönetici izni gerekmez</p>
  </div>

  <div class="wrap hero-stage" id="demo">
    <Desktop>
      <div slot="between" class="demo-intro">
        <h2 class="section-title">Hadi, kendine göre yap.</h2>
        <p class="section-lead">
          Yukarıdaki masaüstü gerçekten çalışır. Widget'lara tıkla, sağ tıkla, sürükleyip sırala. Dock'u başka kenara taşı ya da tamamen kapat.
        </p>
      </div>
    </Desktop>
    <p class="fine demo-note">
      Demo tarayıcında çalışır. Saat gerçek; hava durumu, sistem değerleri ve çalan parçalar örnektir.
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(48px, 9vw, 104px);
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: -68px 0 auto;
    height: 900px;
    background:
      radial-gradient(60% 50% at 50% 0%, rgb(0 103 192 / 0.28), transparent 70%),
      radial-gradient(40% 35% at 50% 62%, rgb(76 194 255 / 0.12), transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  .hero-copy {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 22px;
  }
  .hero-title {
    font-size: clamp(3rem, 8.2vw, 6rem);
    font-weight: 800;
    line-height: 0.96;
    letter-spacing: -0.04em;
    display: grid;
  }
  .line {
    display: block;
    overflow: clip;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .line > span {
    display: inline-block;
  }
  .hero-lead {
    max-width: 40ch;
    font-size: clamp(1.125rem, 1.9vw, 1.375rem);
    line-height: 1.45;
    color: var(--text-2);
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 6px;
  }
  .hero-cta .btn {
    --btn-h: 52px;
    padding-inline: 24px;
    font-size: 1.0625rem;
  }
  .hero-cta .btn :global(span) {
    width: 18px;
    height: 18px;
    display: grid;
  }
  .hero-fine {
    margin-top: -4px;
  }
  .hero-stage {
    margin-top: clamp(48px, 7vw, 88px);
    width: min(100% - 2 * var(--gutter), 1320px);
  }
  .demo-intro {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 16px;
    margin-top: clamp(56px, 8vw, 96px);
  }
  .demo-note {
    text-align: center;
    margin-top: 14px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .line > span {
      animation: rise 900ms var(--ease-out) both;
    }
    .line:nth-child(2) > span {
      animation-delay: 90ms;
    }
    .hero-lead,
    .hero-cta,
    .hero-fine {
      animation: fade-up 800ms var(--ease-out) both;
      animation-delay: 220ms;
    }
    .hero-cta {
      animation-delay: 300ms;
    }
    .hero-fine {
      animation-delay: 360ms;
    }
    .hero-stage :global(.stage-shell) {
      animation: stage-in 1100ms var(--ease-out) both;
      animation-delay: 250ms;
    }
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  @keyframes stage-in {
    from {
      opacity: 0;
      transform: translateY(60px);
    }
  }
</style>
