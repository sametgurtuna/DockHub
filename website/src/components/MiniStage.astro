---
import Bloom from './Bloom.astro';
import { icons, windowsLogo } from '../lib/icons';
import { appIcons } from '../lib/apps';

interface Props {
  id: string;
  spec: string;
  edge?: 'bottom' | 'top' | 'left' | 'right';
  layout?: 'floating' | 'attached';
  mode?: 'replace' | 'both';
  size?: 'small' | 'medium' | 'large';
  theme?: 'dark' | 'light';
  phase?: 'ready' | 'exited' | 'boot';
  cycle?: string;
  panel?: string;
  taskbar?: boolean;
  class?: string;
  label?: string;
}

const {
  id,
  spec,
  edge = 'bottom',
  layout = 'floating',
  mode = 'replace',
  size = 'small',
  theme = 'dark',
  phase = 'ready',
  cycle,
  panel,
  taskbar = false,
  class: className = '',
  label,
} = Astro.props;
---

<div
  class:list={['stage', 'stage-mini', className]}
  data-mini
  data-spec={spec}
  data-edge={edge}
  data-layout={layout}
  data-mode={mode}
  data-size={size}
  data-theme={theme}
  data-backdrop="blur"
  data-phase={phase}
  data-cycle={cycle}
  data-panel={panel}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  inert
>
  <Bloom id={id} />
  {
    taskbar && (
      <div class="win-taskbar">
        <div class="wtb-left" />
        <div class="wtb-center">
          <span class="wtb-btn wtb-start" set:html={windowsLogo(`${id}-wl`)} />
          <span class="wtb-btn" set:html={icons.search} />
          <span class="wtb-btn wtb-app" set:html={appIcons.explorer} />
          <span class="wtb-btn wtb-app" set:html={appIcons.browser} />
          <span class="wtb-btn wtb-app" set:html={appIcons.terminal} />
        </div>
        <div class="wtb-right">
          <span class="wtb-ic" set:html={icons.chevronUp} />
          <span class="wtb-ic" set:html={icons.wifi} />
          <span class="wtb-ic" set:html={icons.volume} />
          <span class="wtb-clock" data-mini-clock>
            <span>--:--</span>
            <span>--.--.----</span>
          </span>
        </div>
      </div>
    )
  }
  <div data-dock-slot></div>
  <slot />
</div>
