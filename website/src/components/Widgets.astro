---
import { widgets } from '../scripts/widgets';
import { icons } from '../lib/icons';
import { site } from '../lib/site';

const cats = ['Saatler', 'Hatırlatıcılar', 'Notlar', 'Medya', 'Sistem', 'Hava durumu'] as const;
const counts = Object.fromEntries(cats.map((c) => [c, widgets.filter((w) => w.category === c).length]));
---

<section class="section" id="widgetlar">
  <div class="wrap">
    <div class="section-head reveal">
      <h2 class="section-title">Bol widget. Hepsi dahil.</h2>
      <p class="section-lead">
        {widgets.length} widget, çoğu birden fazla görünümle. Aynı widget'ı istediğin kadar ekle; her kopyanın kendi ayarları olur.
      </p>
    </div>

    <div class="filters reveal" role="tablist" aria-label="Widget kategorileri" data-filters>
      <button type="button" role="tab" aria-selected="true" data-filter="*">Tümü <span>{widgets.length}</span></button>
      {cats.map((c) => <button type="button" role="tab" aria-selected="false" data-filter={c}>{c} <span>{counts[c]}</span></button>)}
    </div>

    <div class="wgrid" data-wgrid>
      {
        widgets.map((w) => (
          <article class="wtile" data-cat={w.category} data-id={w.id} style={`--accent-w2:${w.accent}`}>
            <div class="wtile-stage">
              <div class="stage stage-strip" data-theme="dark" data-size="large" data-edge="bottom" data-layout="floating" data-mode="replace" data-backdrop="blur" data-phase="ready">
                <div class="strip">
                  <div class="widget-btn" data-preview role="button" tabindex="0" aria-label={`${w.name} önizlemesi: tıklayınca ${w.variants.length > 1 ? 'görünüm değişir' : 'çalışır'}`} />
                </div>
              </div>
            </div>
            <div class="wtile-body">
              <div class="wtile-head">
                <span class="wtile-ic" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="${w.icon}"/></svg>`} />
                <h3>{w.name}</h3>
              </div>
              <p>{w.description}</p>
              <div class="wtile-foot">
                {w.variants.length > 1 ? (
                  <div class="chips" role="radiogroup" aria-label={`${w.name} görünümleri`}>
                    {w.variants.map((v, i) => (
                      <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-variant={v.id}>
                        {v.name}
                      </button>
                    ))}
                  </div>
                ) : (
                  <span class="single">Tek görünüm</span>
                )}
                <button class="add" type="button" data-add>
                  <span class="add-ic" set:html={icons.plus} />
                  <span class="add-label">Demoya ekle</span>
                </button>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p class="idea reveal">
      Aklında başka bir widget mı var? <a href={site.githubUrl}>GitHub'da bir öneri aç</a>, yenileri düzenli olarak ekleniyor.
    </p>
  </div>
</section>

<script>
  import { initGallery } from '../scripts/gallery';
  initGallery();
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: -24px auto clamp(28px, 4vw, 44px);
  }
  .filters button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding: 0 14px;
    border-radius: 99px;
    font-size: 0.9375rem;
    font-weight: 560;
    color: var(--text-2);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      background-color var(--t-fast),
      color var(--t-fast);
  }
  .filters button span {
    font-size: 0.8125rem;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }
  .filters button:hover {
    color: var(--text);
    background: var(--surface-hover);
  }
  .filters button[aria-selected='true'] {
    color: var(--accent-ink);
    background: var(--accent);
    box-shadow: none;
  }
  .filters button[aria-selected='true'] span {
    color: rgb(0 19 31 / 0.6);
  }

  .wgrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .wtile {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: 20px;
    background: var(--bg-raised);
    box-shadow: inset 0 0 0 1px var(--line);
    overflow: hidden;
    view-transition-class: wtile;
    transition: box-shadow var(--t-med) var(--ease-out);
  }
  .wtile:hover {
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .wtile[hidden] {
    display: none;
  }
  .wtile-stage {
    padding: 10px 10px 0;
  }
  .wtile-stage :global(.stage-strip) {
    height: 150px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    animation: none;
    transform: none;
    background:
      radial-gradient(120% 90% at 50% 120%, color-mix(in srgb, var(--accent-w2) 34%, transparent), transparent 60%),
      radial-gradient(80% 80% at 20% -10%, rgb(0 103 192 / 0.35), transparent 60%),
      #070b16;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.06);
    user-select: none;
  }
  .strip {
    display: flex;
    align-items: center;
    padding: 6px;
    border-radius: 16px;
    background: rgb(27 27 32 / 0.55);
    backdrop-filter: blur(20px) saturate(1.5);
    -webkit-backdrop-filter: blur(20px) saturate(1.5);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.12),
      0 14px 30px -12px rgb(0 0 0 / 0.6);
    max-width: calc(100% - 20px);
    overflow: hidden;
  }
  .strip :global(.widget-btn) {
    cursor: pointer;
  }
  .strip :global(.wc) {
    animation: swap 420ms var(--ease-out);
  }
  @keyframes swap {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
  }
  .wtile-body {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 20px 22px 22px;
  }
  .wtile-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .wtile-ic {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    color: var(--accent-w2);
    background: color-mix(in srgb, var(--accent-w2) 14%, transparent);
  }
  .wtile-ic :global(svg) {
    width: 18px;
    height: 18px;
  }
  .wtile h3 {
    font-size: 1.1875rem;
    letter-spacing: -0.015em;
  }
  .wtile p {
    color: var(--text-2);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .wtile-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 6px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .chips button {
    height: 28px;
    padding: 0 10px;
    border-radius: 6px;
    font-size: 0.8125rem;
    font-weight: 560;
    color: var(--text-2);
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      color var(--t-fast),
      background-color var(--t-fast),
      box-shadow var(--t-fast);
  }
  .chips button:hover {
    color: var(--text);
  }
  .chips button[aria-checked='true'] {
    color: var(--text);
    background: var(--surface-hover);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .single {
    font-size: 0.8125rem;
    color: var(--text-3);
  }
  .add {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 12px 0 8px;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 620;
    color: var(--accent);
    background: rgb(76 194 255 / 0.1);
    transition:
      background-color var(--t-fast),
      color var(--t-fast);
  }
  .add:hover {
    background: rgb(76 194 255 / 0.18);
  }
  .add-ic {
    display: grid;
    width: 16px;
    height: 16px;
  }
  .add-ic :global(svg) {
    width: 100%;
    height: 100%;
    stroke-width: 2.2;
  }
  .add.is-done {
    color: var(--c-green);
    background: rgb(50 215 75 / 0.12);
  }
  .idea {
    margin-top: 32px;
    text-align: center;
    color: var(--text-3);
  }
  .idea a {
    color: var(--text-2);
  }
  .idea a:hover {
    color: var(--text);
  }

  @media (max-width: 1080px) {
    .wgrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .wgrid {
      grid-template-columns: 1fr;
    }
    .filters {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .filters button {
      flex: none;
    }
  }
</style>
