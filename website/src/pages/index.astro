---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Modes from '../components/Modes.astro';
import Widgets from '../components/Widgets.astro';
import Bento from '../components/Bento.astro';
import Safety from '../components/Safety.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Custom Dock · Windows için widget'lı dock"
  description="Windows görev çubuğunun yerini alan, cam efektli ve widget destekli ücretsiz, açık kaynak dock. Tarayıcıda canlı demoyu dene."
>
  <Nav />
  <main id="icerik">
    <Hero />
    <Modes />
    <Widgets />
    <Bento />
    <Safety />
    <Faq />
    <Cta />
  </main>
  <Footer />
</Base>
